---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const origin = Astro.site ?? 'https://willmau.com';
const canonical = new URL(Astro.url.pathname, origin);
const ogImage = new URL('/og.jpg', origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#16183c" />
    <meta name="color-scheme" content="light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Will Mau" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Will Mau, Rotterdam, New York" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Site-wide structured data: Person + WebSite. Loads on every page so search engines see a consistent entity for "Will Mau" regardless of which page they crawl first. */}
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://willmau.com/#person',
          name: 'Will Mau',
          givenName: 'William',
          familyName: 'Mau',
          alternateName: ['William Mau', 'Will Mau'],
          description: 'Vice President of Operations at TalentSmartEQ, elected member of the Schalmont Central School District Board of Education, committee chair of Scouting America Troop 54, and founder of Mauops. Based in Rotterdam, New York.',
          url: 'https://willmau.com/',
          image: 'https://willmau.com/og.jpg',
          jobTitle: 'Vice President of Operations',
          worksFor: {
            '@type': 'Organization',
            name: 'TalentSmartEQ',
            url: 'https://www.talentsmarteq.com',
          },
          affiliation: [
            { '@type': 'Organization', name: 'Schalmont Central School District Board of Education', url: 'https://www.schalmont.org/' },
            { '@type': 'Organization', name: 'Scouting America, Troop 54', url: 'https://www.troop3054.org' },
            { '@type': 'Organization', name: 'Mauops', url: 'https://mauops.com' },
          ],
          homeLocation: {
            '@type': 'Place',
            address: { '@type': 'PostalAddress', addressLocality: 'Rotterdam', addressRegion: 'NY', addressCountry: 'US' },
          },
          alumniOf: [
            { '@type': 'CollegeOrUniversity', name: 'The College of Saint Rose', url: 'https://www.strose.edu' },
            { '@type': 'CollegeOrUniversity', name: 'University at Albany, SUNY', url: 'https://www.albany.edu' },
          ],
          knowsAbout: [
            'Revenue operations',
            'Business technology',
            'Salesforce administration',
            'Apex and Lightning Web Components',
            'AI automation',
            'Azure OpenAI',
            'Process improvement',
            'Sales operations',
            'School board governance',
            'K-12 public education policy',
            'Civic engagement',
            'Scouting',
          ],
          sameAs: [
            'https://www.linkedin.com/in/will-mau/',
            'https://mauops.com',
            'https://www.facebook.com/people/Will-Mau-for-Schalmont-Board-of-Education/61567429940268/',
          ],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://willmau.com/#website',
          name: 'Will Mau',
          url: 'https://willmau.com/',
          publisher: { '@id': 'https://willmau.com/#person' },
          inLanguage: 'en-US',
        },
      ],
    })} />

    <slot name="head" />

    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script>
      const reveal = () => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      };
      reveal();
      document.addEventListener('astro:after-swap', reveal);
    </script>
  </body>
</html>
