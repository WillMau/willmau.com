  .share { display: grid; gap: 10px; }
  .share textarea { font-family: var(--serif); font-size: 0.98rem; line-height: 1.5; color: var(--vine); background: #fff; border: 1.5px solid rgba(0, 60, 96, 0.25); border-radius: 6px; padding: 12px 14px; min-height: 168px; width: 100%; resize: vertical; }
  .share .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
