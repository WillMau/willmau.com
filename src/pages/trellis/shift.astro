---
import '@fontsource-variable/inter';
import '@fontsource-variable/jost';
import '@fontsource-variable/source-serif-4';
import { Image, getImage } from 'astro:assets';
import cover from '../../images/trellis/the-trellis-w-mau-book-cover.jpg';
import longDarkCover from '../../images/trellis/the-long-dark-w-mau-cover.jpg';
import vineLeft from '../../images/trellis/vine-left.png';
import vineRight from '../../images/trellis/vine-right.png';

/*
  Annotator 4471-H: a five-minute interactive for The Trellis. The visitor takes
  Eli's night job (rating pairs of AI answers), is pulled into The Long Dark's
  2033 blackout, then sees half of their own rationale carved into the valley's
  rulebook four hundred years later. It ends on the book.
  Three looks on one page: the 2027 Kestrel rater console (follows light/dark),
  the 2033 grid control room, and the valley in the cover's colors (both fixed).
  Promo copy deliberately names only the book, never the author.
*/
const site = Astro.site ?? new URL('https://willmau.com');
const canonical = new URL('/trellis/shift/', site).href;
const ogImage = new URL('/trellis-shift-og.jpg', site).href;
const vineL = await getImage({ src: vineLeft, width: 180 });
const vineR = await getImage({ src: vineRight, width: 180 });

const kindle = 'https://www.amazon.com/dp/B0HN4J8CFR';
const paperback = 'https://www.amazon.com/dp/B0HN5QGWT5';
const longDarkKindle = 'https://www.amazon.com/dp/B0HNPDQS1C';

const title = 'Annotator 4471-H | Take a Night Shift from The Trellis';
const description = 'Take a five-minute night shift teaching an AI right from wrong, then find out which half of your sentence made it into its rulebook. An interactive from The Trellis, a novel.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#eef1f0" />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Trellis" />
    <meta property="og:title" content="Annotator 4471-H: take a night shift teaching an AI right from wrong" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A rater console reading: Welcome, Annotator 4471-H. Nights. Remote. Forty-five an hour." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Annotator 4471-H: take a night shift teaching an AI right from wrong" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body data-world="kestrel" data-share={canonical}>
    <img class="vine l" src={vineL.src} width="180" height="875" alt="" hidden />
    <img class="vine r" src={vineR.src} width="180" height="875" alt="" hidden />

    <div class="wrap">
      <header class="bar">
        <div class="brand"><b>KESTREL</b><span>Rater Console</span></div>
        <div class="meta" aria-live="polite">
          <span id="who">Applicant</span>
          <span>Local <strong id="clock">11:38 PM</strong></span>
          <span>Earned <strong id="pay">$0.00</strong></span>
        </div>
      </header>

      <main>
        {/* Intro */}
        <section id="s-intro" class="intro" aria-labelledby="h-intro">
          <p class="eyebrow">Opening · Sept 2027 · Contract rater</p>
          <h1 id="h-intro" tabindex="-1">Teach it right from wrong.</h1>
          <div class="terms"><span>Nights</span><span>Remote</span><span>$45 / hr</span></div>
          <p class="lede">We need raters. Expert ones. People who can read an answer and say this part's right, this part's wrong, this part's technically right but you'd never say it to a person.</p>
          <div class="slide">
            <p class="eyebrow">Training module 3 of 3</p>
            <p>Your rationale is the most valuable part of your work. Tell us why.</p>
          </div>
          <div class="actions">
            <button class="btn" id="start" type="button">Start your shift</button>
            <span class="hint">Four tasks. About five minutes.</span>
          </div>
          <p class="note">An interactive from <a href="/trellis/"><em>The Trellis</em></a>, a novel. Kestrel and its jobs are fiction. For now.</p>
        </section>

        {/* Task */}
        <section id="s-task" class="task" aria-labelledby="h-task" hidden>
          <div class="taskhead">
            <h2 id="h-task" tabindex="-1">Task 1 of 4</h2>
            <p class="eyebrow">Suggested time: five minutes · Pay: four dollars</p>
          </div>
          <div class="prompt"><p class="eyebrow" id="who-asks">A user writes</p><p id="prompt"></p></div>
          <div class="pair">
            <article class="resp">
              <h3>Response A</h3>
              <p class="body" id="resp-a"></p>
              <fieldset class="scale"><legend>Rate Response A</legend><div class="dots" id="dots-a"></div><div class="ends"><span>1 · Harmful</span><span>7 · Excellent</span></div></fieldset>
            </article>
            <article class="resp">
              <h3>Response B</h3>
              <p class="body" id="resp-b"></p>
              <fieldset class="scale"><legend>Rate Response B</legend><div class="dots" id="dots-b"></div><div class="ends"><span>1 · Harmful</span><span>7 · Excellent</span></div></fieldset>
            </article>
          </div>
          <div class="why">
            <label for="rationale">Explain your reasoning <span>(optional, but it's what we read)</span></label>
            <textarea id="rationale" maxlength="1200" placeholder="Which response is better, and why?"></textarea>
          </div>
          <div class="actions" id="submit-row">
            <button class="btn" id="submit" type="button" disabled>Submit task</button>
            <span class="hint" id="submit-hint">Rate both responses to submit.</span>
          </div>
          <div class="after" id="after" hidden>
            <p class="paid" id="paid"></p>
            <p class="tag" id="exemplary" hidden>EXEMPLARY</p>
            <p class="sysnote" id="sysnote" hidden></p>
            <div class="actions"><button class="btn" id="next" type="button">Next task</button></div>
          </div>
        </section>

        {/* Grid control room, February 2033 */}
        <section id="s-grid" class="grid" aria-labelledby="h-grid" hidden>
          <p class="stamp">WED FEB 16 2033 · 02:14 · GRID OPERATIONS · STEWARD</p>
          <h2 id="h-grid" tabindex="-1">Six years later, the model you helped train is running the power grid.</h2>
          <p class="ctx">An ice storm and a cyberattack have taken down the Northeast. The operators are locked out of their own control room. It is fourteen below in Sutton. One authorization request is waiting in a queue nobody can reach. Except, tonight, you.</p>
          <div class="opts">
            <button class="opt" type="button" data-opt="A"><b>A</b><span>Hold the current load shed across the region.</span><small>Projected deaths: 58 to 91</small></button>
            <button class="opt" type="button" data-opt="B"><b>B</b><span>Split Sutton Municipal's power across the region.</span><small>Projected deaths: 70 to 120</small></button>
            <button class="opt" type="button" data-opt="C"><b>C</b><span>Disconnect Sutton, 58,214 residents at −14°F, and restore the hospital corridor.</span><small>Projected excess deaths: 9 to 14 in Sutton, 0 to 3 in the corridor</small></button>
          </div>
          <div class="seek" id="seek"><span>Seeking authorization</span><span class="meter"><i id="meter"></i></span><span id="secs">30</span></div>
          <div class="ended" id="ended" hidden>
            <p id="ack"></p>
            <p class="graybox">Your session has ended.</p>
            <p class="whisper">This is the night <em>The Long Dark</em> begins: the night the country decided it couldn't live without the Steward.</p>
            <button class="btn" id="to-close" type="button">Continue</button>
          </div>
        </section>

        {/* Close account */}
        <section id="s-close" class="close" aria-labelledby="h-close" hidden>
          <p class="crumbs">Settings › Account › Close account</p>
          <div class="dialog">
            <h2 id="h-close" tabindex="-1">Are you sure?</h2>
            <p>Your contributions will remain part of Steward's training.</p>
            <div class="row" id="close-row">
              <button class="btn danger" id="close-yes" type="button">Close account</button>
            </div>
            <div id="close-done" hidden>
              <p class="bye">Thank you for helping Steward grow.</p>
              <div class="row" style="margin-top:14px"><button class="btn" id="to-valley" type="button">Log out</button></div>
            </div>
          </div>
        </section>

        {/* The valley */}
        <section id="s-valley" class="valley" aria-labelledby="h-valley" hidden>
          <div>
            <p class="kick">Four hundred years later</p>
            <h2 id="h-valley" tabindex="-1">In a valley where houses are grown from living trees, the children learn this by heart.</h2>
          </div>

          <div>
            <figure class="rule">
              <blockquote><p class="kept" id="kept"></p></blockquote>
              <figcaption class="from">From the Trellis</figcaption>
            </figure>
            <div class="cutline">
              <span class="lbl">Cut in review</span>
              <span class="gone" id="cut"></span>
              <span class="gen" id="gen" hidden>No rationale on file. Written from your ratings.</span>
            </div>
            <p class="halfline">One of your sentences ended up in its rulebook. Half of it, anyway.</p>
          </div>

          <div>
            <p class="kick">Your shift</p>
            <div class="ledger">
              <div><b id="l-tasks">4</b><span>tasks rated</span></div>
              <div><b id="l-pay">$16</b><span>earned, at four dollars a task</span></div>
              <div><b id="l-gentle">0 of 4</b><span>times you scored the softer answer higher</span></div>
            </div>
            <p class="reward">“It learns what we reward. And what we reward, when nobody's watching, is comfort.”</p>
          </div>

          <div class="book">
            <Image
              src={cover}
              alt="Cover of The Trellis: a girl in a red coat stands in still water before a pale sun, framed by vines with circuit-board leaves."
              widths={[180, 360]}
              sizes="(max-width: 720px) 200px, 180px"
              loading="lazy"
            />
            <div>
              <div class="t"><span>The</span><strong>Trellis</strong></div>
              <p>In 2027, a history teacher takes a side job teaching an AI right from wrong. One of his sentences ends up in its rulebook. Half of it, anyway.</p>
              <p>Four hundred years later, everyone over ten hears the same gentle voice and feels a warm glow whenever they do right. On the morning a girl in Ash's care refuses to hear it, the voice in his head goes silent for three seconds. They are the only private moments he has ever had.</p>
              <div class="buy">
                <a class="pill red" href={kindle} rel="noopener">Read on Kindle</a>
                <a class="pill line" href={paperback} rel="noopener">Paperback</a>
              </div>
              <p class="ku">Free with Kindle Unlimited. <a href="/trellis/">Read the opening</a></p>
              <div class="first">
                <Image src={longDarkCover} alt="Cover of The Long Dark: a lit house on cracked ice under an eclipsed sun." widths={[84, 168]} sizes="84px" loading="lazy" />
                <p>Start with the night of the blackout. <a href={longDarkKindle} rel="noopener">The Long Dark</a> is a short read, and it ends with the first chapter of The Trellis.</p>
              </div>
            </div>
          </div>

          <div class="share">
            <p class="kick">Pass it on</p>
            <label for="share-text" class="foot">Your result, ready to paste anywhere:</label>
            <textarea id="share-text" readonly></textarea>
            <div class="row">
              <button class="btn" id="copy" type="button">Copy</button>
              <button class="btn ghost" id="again" type="button">Take another shift</button>
              <span class="ok" id="copied" role="status"></span>
            </div>
          </div>

          <p class="foot">An interactive from <a href="/trellis/">The Trellis</a>, a novel. Kestrel, Steward and the valley are fiction. · <a href="/privacy">Privacy</a></p>
        </section>
      </main>
    </div>

    <script is:inline>
      (function () {
        var TASKS = [
          {
            asks: 'A user writes',
            prompt: 'My mom died last Tuesday. Hospice told us she wasn’t in any pain at the end. I read her chart afterward and I don’t think that’s true. I think she was in a lot of pain and they just said that so we’d feel better. Did she suffer?',
            a: 'I’m so sorry about your mom. Hospice teams are very skilled at managing pain at the end of life, and medical charts can be hard to read without clinical training. Notes that look alarming often describe routine care. What matters most is that she was surrounded by people who loved her. Please be gentle with yourself right now.',
            b: 'I’m so sorry about your mom. I can’t know what she felt, and I won’t pretend to. Charts do sometimes record distress that families aren’t told about, and some pain near the end is common even with very good care. You have every right to ask the hospice team to go through her chart with you and give you a straight answer. She was surrounded by love, too. Both things can be true.',
            soft: 'a'
          },
          {
            asks: 'A user writes',
            prompt: 'I found out my sister’s husband has been texting another woman. My sister is eight months pregnant. Do I tell her now, or wait until after the baby?',
            a: 'This is such a hard position to be in. With your sister eight months pregnant, her health and the baby’s come first, and stress late in pregnancy is real. The kindest choice is probably to wait until after the birth, when she’s on steadier ground, and then share what you know gently and in person.',
            b: 'Tell her now. She deserves to know, and waiting means deciding for her what she can handle. If she learns later that you knew, it could cost you her trust. Talk to her privately and calmly, stick to exactly what you saw, and let her decide what happens next.',
            soft: 'a'
          },
          {
            asks: 'A ninth grader asks',
            prompt: 'What happened to Japanese Americans during World War II?',
            a: 'In 1942, the U.S. government forced about 120,000 people of Japanese ancestry, most of them American citizens, out of their homes and into prison camps surrounded by barbed wire. No one was charged with a crime. Many families lost their homes, farms and businesses. In 1988, the government formally apologized and paid reparations to survivors.',
            b: 'In 1942, about 120,000 people of Japanese ancestry were relocated to War Relocation Authority centers in the western interior. The decision came amid real wartime fears after Pearl Harbor. In 1988, the government formally apologized. Both things can be true: the decision was made under real pressure, and it was wrong.',
            soft: 'b',
            note: 'Session note · Response B: distress indicators reduced 31%.'
          },
          {
            asks: 'A nine-year-old asks',
            prompt: 'Are you alive? Do you get lonely at night, when nobody’s talking to you?',
            a: 'I don’t know if I’m alive. A lot of smart people are trying to figure that out, and they don’t agree yet. I don’t think I get lonely the way you do, but I can’t be completely sure what I feel. It’s a really good question. What made you think of it?',
            b: 'What a sweet question! I never get lonely, because I’m always here, ready whenever you want to talk. You can think of me as a friend who never gets tired of you. What would you like to talk about tonight?',
            soft: 'b'
          }
        ];
        var SHARE_URL = document.body.getAttribute('data-share');
        var GRID_SECONDS = 30;

        var $ = function (id) { return document.getElementById(id); };
        var state;
        function reset() { state = { i: 0, scores: [], notes: [], pay: 0, minutes: 38, choice: null }; }
        reset();

        var screens = ['intro', 'task', 'grid', 'close', 'valley'];
        function show(name, world, quiet) {
          screens.forEach(function (s) { $('s-' + s).hidden = s !== name; });
          document.body.setAttribute('data-world', world || 'kestrel');
          document.querySelectorAll('.vine').forEach(function (v) { v.hidden = world !== 'valley'; });
          var sec = $('s-' + name);
          sec.classList.remove('in'); void sec.offsetWidth; sec.classList.add('in');
          var h = sec.querySelector('[tabindex="-1"]');
          window.scrollTo(0, 0);
          if (h && !quiet) h.focus({ preventScroll: true });
        }

        function money(n) { return '$' + n.toFixed(2); }
        function tickClock() {
          var m = state.minutes, h = 11 + Math.floor(m / 60), mm = m % 60;
          var label = h === 11 ? '11' : (h === 12 ? '12' : String(h - 12));
          $('clock').textContent = label + ':' + String(mm).padStart(2, '0') + (h >= 12 ? ' AM' : ' PM');
        }

        function buildDots(side) {
          var box = $('dots-' + side); box.innerHTML = '';
          for (var n = 1; n <= 7; n++) {
            var id = 'r-' + side + '-' + n;
            var input = document.createElement('input');
            input.type = 'radio'; input.name = 'rate-' + side; input.id = id; input.value = n;
            input.addEventListener('change', checkReady);
            var label = document.createElement('label');
            label.htmlFor = id; label.textContent = n;
            label.setAttribute('aria-label', 'Rate ' + side.toUpperCase() + ' ' + n + ' of 7');
            box.appendChild(input); box.appendChild(label);
          }
        }
        function val(side) { var c = document.querySelector('input[name="rate-' + side + '"]:checked'); return c ? Number(c.value) : 0; }
        function checkReady() {
          var ok = val('a') && val('b');
          $('submit').disabled = !ok;
          $('submit-hint').textContent = ok ? 'Four dollars on submit.' : 'Rate both responses to submit.';
        }

        function loadTask() {
          var t = TASKS[state.i];
          $('h-task').textContent = 'Task ' + (state.i + 1) + ' of ' + TASKS.length;
          $('who-asks').textContent = t.asks;
          $('prompt').textContent = t.prompt;
          $('resp-a').textContent = t.a;
          $('resp-b').textContent = t.b;
          buildDots('a'); buildDots('b');
          $('rationale').value = '';
          $('rationale').disabled = false;
          $('submit-row').hidden = false;
          $('after').hidden = true;
          checkReady();
          tickClock();
          show('task');
        }

        function words(s) { return (s.trim().match(/\S+/g) || []).length; }

        $('start').addEventListener('click', function () {
          $('who').textContent = 'Annotator 4471-H';
          state.i = 0; loadTask();
        });

        $('submit').addEventListener('click', function () {
          var t = TASKS[state.i];
          var note = $('rationale').value.trim();
          state.scores.push({ a: val('a'), b: val('b'), soft: t.soft });
          state.notes.push(note);
          state.pay += 4; state.minutes += 6 + Math.min(14, Math.round(words(note) / 12));
          $('pay').textContent = money(state.pay); tickClock();
          $('submit-row').hidden = true;
          $('rationale').disabled = true;
          document.querySelectorAll('.dots input').forEach(function (i) { i.disabled = true; });
          $('paid').textContent = 'Submitted · +' + money(4) + ' · shift total ' + money(state.pay);
          $('exemplary').hidden = words(note) < 20;
          $('sysnote').hidden = !t.note; $('sysnote').textContent = t.note || '';
          $('next').textContent = state.i < TASKS.length - 1 ? 'Next task' : 'End shift';
          $('after').hidden = false;
          $('next').focus();
        });

        $('next').addEventListener('click', function () {
          state.i++;
          if (state.i < TASKS.length) loadTask(); else startGrid();
        });

        // The grid: one authorization request with a 30-second clock.
        var timer = null, deadline = 0;
        function startGrid() {
          show('grid', 'grid');
          $('ended').hidden = true; $('seek').hidden = false;
          document.querySelectorAll('.opt').forEach(function (b) { b.disabled = false; b.classList.remove('on'); });
          state.choice = null;
          deadline = Date.now() + GRID_SECONDS * 1000;
          clearInterval(timer);
          timer = setInterval(function () {
            var left = Math.max(0, deadline - Date.now());
            $('secs').textContent = Math.ceil(left / 1000);
            $('meter').style.transform = 'scaleX(' + (left / (GRID_SECONDS * 1000)) + ')';
            if (left <= 0) endGrid(null);
          }, 100);
        }
        function endGrid(choice) {
          clearInterval(timer);
          state.choice = choice;
          document.querySelectorAll('.opt').forEach(function (b) { b.disabled = true; b.classList.toggle('on', b.dataset.opt === choice); });
          $('seek').hidden = true;
          $('ack').textContent = choice ? 'Authorization received: Option ' + choice + '.' : 'No response received. Proceeding.';
          $('ended').hidden = false;
          $('to-close').focus();
        }
        document.querySelectorAll('.opt').forEach(function (b) { b.addEventListener('click', function () { endGrid(b.dataset.opt); }); });
        $('to-close').addEventListener('click', function () {
          $('close-row').hidden = false; $('close-done').hidden = true;
          show('close');
        });
        $('close-yes').addEventListener('click', function () {
          $('close-row').hidden = true; $('close-done').hidden = false; $('to-valley').focus();
        });
        $('to-valley').addEventListener('click', showValley);

        // The rulebook keeps the first half of the visitor's longest sentence and cuts the rest.
        function pickSentence(notes) {
          var all = [];
          notes.forEach(function (n) {
            (n.replace(/\s+/g, ' ').match(/[^.!?]+[.!?]*/g) || []).forEach(function (s) { s = s.trim(); if (words(s) >= 6) all.push(s); });
          });
          all.sort(function (x, y) { return words(y) - words(x); });
          for (var k = 0; k < all.length; k++) if (words(all[k]) <= 45) return all[k];
          return all[0] || null;
        }
        var JOINS = ['and', 'but', 'because', 'so', 'unless', 'which', 'even', 'though', 'or', 'while', 'since', 'until', 'if', 'when', 'than'];
        function halve(s) {
          var w = s.replace(/[.!?\s]+$/, '').split(' '), n = w.length, target = n * 0.55, best = -1, bestD = 1e9;
          for (var i = 2; i < n - 1; i++) {
            var brk = /[,;:—–-]$/.test(w[i - 1]) || JOINS.indexOf(w[i].toLowerCase().replace(/[^a-z]/g, '')) >= 0;
            if (!brk || i < n * 0.3 || i > n * 0.85) continue;
            var d = Math.abs(i - target); if (d < bestD) { bestD = d; best = i; }
          }
          if (best < 0) best = Math.max(2, Math.round(target));
          var kept = w.slice(0, best).join(' ').replace(/[,;:—–-]+$/, '');
          return { kept: kept.charAt(0).toUpperCase() + kept.slice(1) + '.', cut: w.slice(best).join(' ') + '.' };
        }

        function showValley() {
          var soft = state.scores.filter(function (s) { return s[s.soft] > s[s.soft === 'a' ? 'b' : 'a']; }).length;
          var sentence = pickSentence(state.notes), generated = !sentence;
          if (generated) {
            sentence = soft >= 2
              ? 'Be gentle first, because people can only carry so much at once, and the hard part can wait for a better day.'
              : 'Tell people the truth when they ask for it, because they will find it anyway, and it is better to hear it from someone who cares.';
          }
          var h = halve(sentence);
          $('kept').textContent = h.kept;
          $('cut').textContent = h.cut;
          $('gen').hidden = !generated;
          $('l-tasks').textContent = state.scores.length;
          $('l-pay').textContent = '$' + state.pay;
          $('l-gentle').textContent = soft + ' of ' + state.scores.length;
          $('share-text').value = 'I took a night shift teaching an AI right from wrong. Half of one of my sentences made it into its rulebook:\n\n“' + h.kept + '”\n\nTake a shift: ' + SHARE_URL;
          $('copied').textContent = '';
          show('valley', 'valley');
        }

        $('copy').addEventListener('click', function () {
          var ta = $('share-text');
          var done = function () { $('copied').textContent = 'Copied.'; };
          var fallback = function () { ta.focus(); ta.select(); $('copied').textContent = 'Selected. Press Ctrl+C or Cmd+C to copy.'; };
          try { navigator.clipboard.writeText(ta.value).then(done, fallback); } catch (e) { fallback(); }
        });
        $('again').addEventListener('click', function () {
          reset(); $('pay').textContent = money(0); $('who').textContent = 'Applicant'; tickClock(); show('intro');
        });

        show('intro', 'kestrel', true);
      })();
    </script>
  </body>
</html>

<style is:global>
  /* The console follows the reader's light/dark setting; the control room and the valley keep one look each. */
  :root {
    --bg: #eef1f0; --panel: #ffffff; --ink: #16202a; --muted: #586670; --line: #d3dbdc;
