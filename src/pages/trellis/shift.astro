  .first { display: grid; grid-template-columns: 84px minmax(0, 1fr); gap: 16px; align-items: center; margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(0, 60, 96, 0.18); }
  .first img { width: 84px; height: auto; box-shadow: 0 10px 20px -12px rgba(0, 12, 24, 0.6); }
  .book .first p { margin: 0; font-size: 0.98rem; }
