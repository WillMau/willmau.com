---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import headshot from '../images/will-mau.webp';

const now = [
  {
    n: '01',
    title: 'Mauops',
    text: 'AI agents and consulting that help small businesses do more with the team they already have.',
    meta: 'mauops.com',
    href: 'https://mauops.com',
    external: true,
  },
  {
    n: '02',
    title: 'Schalmont School Board',
    text: 'Elected trustee in 2023, reelected in 2026 to a second term on the Board of Education.',
    meta: 'Follow on Facebook',
    href: 'https://www.facebook.com/people/Will-Mau-for-Schalmont-Board-of-Education/61567429940268/',
    external: true,
  },
  {
    n: '03',
    title: 'Scouting',
    text: 'Committee chair for the Scout troop that meets at Jefferson Elementary in Rotterdam.',
    meta: 'Volunteer work',
    href: null,
    external: false,
  },
  {
    n: '04',
    title: 'Résumé',
    text: 'Experience, education, and civic work, on one page you can read or download.',
    meta: 'On this site',
    href: '/resume',
    external: false,
  },
];
---

<Base
  title="Will Mau — Rotterdam, New York"
  description="Will Mau of Rotterdam, New York. School board member at Schalmont Central School District and founder of Mauops."
>
  <main id="main">
    {/* ---------- INTRO ---------- */}
    <section class="intro">
      <SiteHeader />
      <div class="wrap intro__inner">
        <div class="intro__head" data-reveal>
          <div class="intro__photo">
            <Image
              src={headshot}
              alt="Will Mau"
              widths={[112, 224, 336]}
              sizes="112px"
            />
          </div>
          <div class="intro__titles">
            <p class="kicker intro__kicker">Rotterdam, New York</p>
            <h1 class="intro__name">Will Mau</h1>
          </div>
        </div>
        <p class="intro__lede" data-reveal data-reveal-delay="1">
          School board member at Schalmont Central School District and
          founder of Mauops, an AI consulting practice. Born and raised in
          Rotterdam, New York.
        </p>
      </div>
    </section>

    {/* ---------- NOW ---------- */}
    <section class="now section" id="now">
      <div class="wrap">
        <h2 class="now__title" data-reveal>What I'm doing now</h2>
        <ul class="grid">
          {
            now.map((item, i) => {
              const Tag = item.href ? 'a' : 'div';
              const linkProps = item.external
                ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
                : item.href
                  ? { href: item.href }
                  : {};
              return (
                <li>
                  <Tag
                    class:list={['card', { 'card--link': item.href }]}
                    data-reveal
                    data-reveal-delay={Math.min(i + 1, 4)}
                    {...linkProps}
                  >
                    <span class="card__n">{item.n}</span>
                    <h3 class="card__title">{item.title}</h3>
                    <p class="card__text">{item.text}</p>
                    <span class="card__meta">
                      {item.meta}
                      {item.href && (
                        <span class="card__arrow" aria-hidden="true">&#8594;</span>
                      )}
                    </span>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    {/* ---------- ABOUT SNAPSHOT ---------- */}
    <section class="snap section">
      <div class="wrap">
        <div class="snap__inner">
          <p class="kicker snap__kicker" data-reveal>A bit of background</p>
          <p class="snap__text" data-reveal data-reveal-delay="1">
            I got into public service by showing up. Three years ago I started
            going to Schalmont board meetings because my daughter's kindergarten
            class was too big. I kept showing up. Eventually I ran.
          </p>
          <a href="/about" class="snap__link" data-reveal data-reveal-delay="2">
            Read the whole story
            <span class="snap__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /* ---------- INTRO ---------- */
  .intro {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .intro__inner {
    padding-block: clamp(0.5rem, 0.3rem + 1vw, 1.5rem) clamp(2.5rem, 2rem + 2.5vw, 4rem);
  }
  .intro__head {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }
  .intro__photo {
    width: clamp(84px, 9vw, 108px);
    height: clamp(84px, 9vw, 108px);
    border-radius: 16px;
    overflow: hidden;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }
  .intro__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }
  .intro__kicker {
    color: var(--green);
    margin-bottom: 0.45rem;
  }
  .intro__name {
    font-size: clamp(2.3rem, 1.7rem + 2.5vw, 3.4rem);
    color: var(--ink);
    line-height: 1;
  }
  .intro__lede {
    margin-top: clamp(1.5rem, 1.1rem + 1.6vw, 2.4rem);
    max-width: 36ch;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.5rem);
    line-height: 1.4;
    color: var(--text);
  }

  /* ---------- NOW ---------- */
  .now { background: var(--paper); }
  .now__title {
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2rem);
    color: var(--ink);
    margin-bottom: clamp(1.5rem, 1.2rem + 1.4vw, 2.4rem);
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 1.1rem + 1vw, 1.95rem);
    color: var(--text);
    transition:
      transform 0.22s var(--ease),
      border-color 0.22s var(--ease),
      box-shadow 0.22s var(--ease);
  }
  .card--link:hover {
    transform: translateY(-3px);
    border-color: var(--green);
    box-shadow: 0 14px 30px rgba(29, 34, 71, 0.1);
  }
  .card__n {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--green);
    margin-bottom: 0.7rem;
  }
  .card__title {
    font-size: 1.3rem;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }
  .card__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-soft);
  }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .card__arrow {
    transition: transform 0.22s var(--ease);
    color: var(--green);
    font-size: 1rem;
  }
  .card--link:hover .card__arrow { transform: translateX(0.25rem); }
  .card--link:hover .card__meta { color: var(--green); }

  /* ---------- SNAPSHOT ---------- */
  .snap { background: var(--paper); }
  .snap__inner {
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.75rem);
  }
  .snap__kicker {
    color: var(--green);
    margin-bottom: 1rem;
  }
  .snap__text {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 1.95rem);
    line-height: 1.36;
    letter-spacing: -0.012em;
    color: var(--ink);
    max-width: var(--measure);
  }
  .snap__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--green);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid currentColor;
  }
  .snap__arrow { transition: transform 0.22s var(--ease); }
  .snap__link:hover .snap__arrow { transform: translateX(0.3rem); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 620px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
