---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import SchalmontShield from '../images/schalmont-shield.svg';
import mauopsLogo from '../images/mauops-logo.png';
import troopLogo from '../images/troop3054-logo.png';
import headshot from '../images/will-headshot.jpg';

const resumeIcon =
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 3h7L18 7.6V21H6.5zM13 3v5h5M9.75 12.5h4.5M9.75 16h4.5"/></svg>';

const now = [
  {
    n: '01',
    kind: 'mauops',
    title: 'Mauops',
    text: 'AI agents and consulting that help small businesses do more with the team they already have.',
    domain: 'mauops.com',
    href: 'https://mauops.com',
  },
  {
    n: '02',
    kind: 'board',
    title: 'Schalmont School Board',
    text: 'Elected trustee in 2023, reelected in 2026 to a second term on the Board of Education.',
    domain: 'Facebook',
    href: 'https://www.facebook.com/people/Will-Mau-for-Schalmont-Board-of-Education/61567429940268/',
  },
  {
    n: '03',
    kind: 'troop',
    title: 'Scouting',
    text: 'Committee chair for Troop 3054, the Scout troop based in Rotterdam.',
    domain: 'troop3054.org',
    href: 'https://www.troop3054.org',
  },
];
---

<Base
  title="Will Mau | Schalmont Board, Mauops | Rotterdam NY"
  description="Will Mau (William Mau) of Rotterdam, New York. Elected member of the Schalmont Central School District Board of Education, VP of Operations at TalentSmartEQ, and founder of Mauops."
>
  <main id="main">
    {/* ---------- INTRO ---------- */}
    <section class="intro">
      <SiteHeader />
      <div class="wrap intro__grid">
        <div class="intro__text">
          <p class="kicker intro__kicker" data-reveal>Rotterdam, New York</p>
          <h1 class="intro__name" data-reveal data-reveal-delay="1">Will Mau</h1>
          <p class="intro__lede" data-reveal data-reveal-delay="2">
            School board member at Schalmont Central School District and
            founder of Mauops, an AI consulting practice. Born and raised in
            Rotterdam, New York.
          </p>
        </div>
        <div class="intro__photo" data-reveal data-reveal-delay="3">
          <Image
            src={headshot}
            alt="Will Mau"
            widths={[320, 480, 640, 800]}
            sizes="(max-width: 760px) 300px, 32vw"
          />
        </div>
      </div>
    </section>

    {/* ---------- NOW ---------- */}
    <section class="now section" id="now">
      <div class="wrap">
        <h2 class="now__title" data-reveal>What I'm doing now</h2>

        <ul class="grid">
          {
            now.map((item, i) => {
              const external = item.href.startsWith('http');
              return (
                <li>
                  <a
                    class="card"
                    href={item.href}
                    data-reveal
                    data-reveal-delay={Math.min(i + 1, 4)}
                    {...(external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    <span class:list={['card__emblem', `card__emblem--${item.kind}`]}>
                      {item.kind === 'mauops' && (
                        <Image
                          src={mauopsLogo}
                          alt="Mauops logo"
                          widths={[72, 144, 216]}
                          sizes="84px"
                        />
                      )}
                      {item.kind === 'troop' && (
                        <Image
                          src={troopLogo}
                          alt="Troop 3054 logo"
                          widths={[80, 160, 240]}
                          sizes="92px"
                        />
                      )}
                      {item.kind === 'board' && (
                        <SchalmontShield class="card__shield" />
                      )}
                    </span>

                    <span class="card__body">
                      <span class="card__head">
                        <span class="card__n">{item.n}</span>
                        <span class="card__domain">{item.domain}</span>
                      </span>
                      <span class="card__title">{item.title}</span>
                      <span class="card__text">{item.text}</span>
                      <span class="card__foot">
                        <span class="card__cta">
                          {external ? 'Visit' : 'Open'}
                        </span>
                        <span class="card__arrow" aria-hidden="true">&#8594;</span>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <a href="/resume" class="resume-band" data-reveal>
          <span class="resume-band__icon" set:html={resumeIcon} />
          <span class="resume-band__text">
            <span class="resume-band__title">The full résumé</span>
            <span class="resume-band__desc">
              Experience, education, and civic work, on one page you can
              read or download.
            </span>
          </span>
          <span class="resume-band__cta">
            View résumé
            <span class="resume-band__arrow" aria-hidden="true">&#8594;</span>
          </span>
        </a>
      </div>
    </section>

    {/* ---------- ABOUT SNAPSHOT ---------- */}
    <section class="snap section">
      <div class="wrap">
        <div class="snap__inner">
          <p class="kicker snap__kicker" data-reveal>A bit of background</p>
          <blockquote class="snap__quote" data-reveal data-reveal-delay="1">
            I got into public service by showing up.
          </blockquote>
          <p class="snap__body" data-reveal data-reveal-delay="2">
            Three years ago I started going to Schalmont board meetings
            because my daughter's kindergarten class was too big. I kept
            showing up. Eventually I ran.
          </p>
          <a href="/about" class="snap__link" data-reveal data-reveal-delay="3">
            Read the whole story
            <span class="snap__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /* ---------- INTRO ---------- */
  .intro {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.95fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem)
      clamp(2.75rem, 2.2rem + 2.6vw, 4.5rem);
  }
  .intro__kicker {
    color: var(--green);
    margin-bottom: 0.65rem;
  }
  .intro__name {
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4rem);
    color: var(--ink);
    line-height: 1;
  }
  .intro__lede {
    margin-top: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    max-width: 32ch;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.5rem);
    line-height: 1.4;
    color: var(--text);
  }

  /* Hero photo */
  .intro__photo {
    min-width: 0;
    aspect-ratio: 1 / 1;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 24px 48px rgba(18, 22, 50, 0.16);
  }
  .intro__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  /* ---------- NOW ---------- */
  .now { background: var(--paper); }
  .now__title {
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2rem);
    color: var(--ink);
    margin-bottom: clamp(1.4rem, 1.1rem + 1.3vw, 2.2rem);
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  /* ---------- STYLIZED LINK CARD ---------- */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    color: var(--text);
    transition:
      transform 0.24s var(--ease),
      border-color 0.24s var(--ease),
      box-shadow 0.24s var(--ease);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--green);
    box-shadow: 0 16px 34px rgba(29, 34, 71, 0.12);
  }
  .card__emblem {
    display: grid;
    place-items: center;
    height: clamp(118px, 8rem + 3vw, 152px);
    border-bottom: 1px solid var(--line);
    background: #eceef4;
  }
  .card__emblem :global(img) {
    width: clamp(64px, 5rem + 1vw, 88px);
    height: clamp(64px, 5rem + 1vw, 88px);
    object-fit: contain;
  }
  .card__shield {
    width: auto;
    height: clamp(62px, 4.5rem + 1.5vw, 84px);
  }
  .card__emblem :global(img),
  .card__shield {
    transition: transform 0.26s var(--ease);
  }
  .card:hover .card__emblem :global(img),
  .card:hover .card__shield {
    transform: scale(1.045);
  }
  .card__emblem--mauops { background: #edeff6; }
  .card__emblem--board { background: #e9f2ec; }
  .card__emblem--troop { background: #f0eee6; }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(1.25rem, 1rem + 0.9vw, 1.7rem);
  }
  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.7rem;
  }
  .card__n {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--green);
  }
  .card__domain {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-soft);
  }
  .card__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.34rem;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .card__text {
    margin-top: 0.45rem;
    font-size: 0.99rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .card__foot {
    margin-top: auto;
    padding-top: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
    transition: color 0.2s var(--ease);
  }
  .card__arrow {
    font-size: 1.05rem;
    transition: transform 0.22s var(--ease);
  }
  .card:hover .card__foot { color: var(--green); }
  .card:hover .card__arrow { transform: translateX(0.3rem); }

  /* ---------- RÉSUMÉ BAND ---------- */
  .resume-band {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.7rem + 1.4vw, 1.75rem);
    margin-top: 1.25rem;
    padding: clamp(1.1rem, 0.9rem + 0.9vw, 1.6rem)
      clamp(1.25rem, 1rem + 1vw, 1.9rem);
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    transition:
      transform 0.24s var(--ease),
      border-color 0.24s var(--ease),
      box-shadow 0.24s var(--ease);
  }
  .resume-band:hover {
    transform: translateY(-3px);
    border-color: var(--green);
    box-shadow: 0 14px 30px rgba(29, 34, 71, 0.1);
  }
  .resume-band__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: clamp(48px, 3.5rem + 1vw, 60px);
    height: clamp(48px, 3.5rem + 1vw, 60px);
    background: #e9f2ec;
    border-radius: 10px;
    color: var(--green);
  }
  .resume-band__icon :global(svg) {
    width: 56%;
    height: 56%;
  }
  .resume-band__text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .resume-band__title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .resume-band__desc {
    font-size: 0.99rem;
    line-height: 1.5;
    color: var(--text-soft);
  }
  .resume-band__cta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-soft);
    transition: color 0.2s var(--ease);
  }
  .resume-band__arrow {
    font-size: 1.05rem;
    transition: transform 0.22s var(--ease);
  }
  .resume-band:hover .resume-band__cta { color: var(--green); }
  .resume-band:hover .resume-band__arrow { transform: translateX(0.3rem); }

  /* ---------- SNAPSHOT ---------- */
  .snap { background: var(--paper); }
  .snap__inner {
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.75rem);
  }
  .snap__kicker {
    color: var(--green);
    margin-bottom: 1rem;
  }
  .snap__quote {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.95rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.14;
    letter-spacing: -0.022em;
    color: var(--ink);
    max-width: 17ch;
  }
  .snap__quote::before {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    background: var(--green);
    margin-bottom: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }
  .snap__body {
    margin-top: clamp(1.25rem, 1rem + 1vw, 1.85rem);
    font-size: 1.1rem;
    line-height: 1.62;
    color: var(--text-soft);
    max-width: 48ch;
  }
  .snap__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--green);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid currentColor;
  }
  .snap__arrow { transition: transform 0.22s var(--ease); }
  .snap__link:hover .snap__arrow { transform: translateX(0.3rem); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 760px) {
    .intro__grid { grid-template-columns: 1fr; }
    .intro__photo {
      max-width: 300px;
      order: -1;
    }
  }
  @media (max-width: 720px) {
    .grid { grid-template-columns: 1fr; }
    .resume-band { flex-wrap: wrap; }
    .resume-band__cta {
      width: 100%;
      padding-top: 0.4rem;
      justify-content: flex-start;
    }
  }
</style>
