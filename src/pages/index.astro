---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { Image } from 'astro:assets';
import headshot from '../images/will-mau.webp';

const now = [
  {
    n: '01',
    title: 'Mauops',
    text: 'AI agents and consulting that help small businesses do more with the team they already have.',
    meta: 'mauops.com',
    href: 'https://mauops.com',
    external: true,
  },
  {
    n: '02',
    title: 'Schalmont School Board',
    text: 'Elected trustee in 2023, reelected in 2026 to a second term on the Board of Education.',
    meta: 'Follow on Facebook',
    href: 'https://www.facebook.com/people/Will-Mau-for-Schalmont-Board-of-Education/61567429940268/',
    external: true,
  },
  {
    n: '03',
    title: 'Scouting',
    text: 'Committee chair for the Scout troop that meets at Jefferson Elementary in Rotterdam.',
    meta: 'Volunteer work',
    href: null,
    external: false,
  },
  {
    n: '04',
    title: 'Résumé',
    text: 'Experience, education, and civic work, on one page you can read or download.',
    meta: 'On this site',
    href: '/resume',
    external: false,
  },
];
---

<Base
  title="Will Mau — Rotterdam, New York"
  description="Will Mau of Rotterdam, New York. School board member at Schalmont Central School District, Scout leader, and founder of Mauops."
>
  <main id="main">
    {/* ---------- HERO ---------- */}
    <section class="hero">
      <SiteHeader />
      <div class="wrap hero__inner">
        <div class="hero__photo" data-reveal>
          <Image
            src={headshot}
            alt="Will Mau"
            widths={[260, 400, 520]}
            sizes="(max-width: 680px) 160px, 260px"
          />
        </div>
        <div class="hero__text">
          <p class="kicker hero__kicker" data-reveal>Rotterdam, New York</p>
          <h1 class="hero__name" data-reveal data-reveal-delay="1">Will Mau</h1>
          <p class="hero__lede" data-reveal data-reveal-delay="2">
            Husband and dad in Rotterdam. School board member at Schalmont,
            Scout troop leader, and founder of Mauops.
          </p>
        </div>
      </div>
    </section>

    {/* ---------- NOW ---------- */}
    <section class="now section" id="now">
      <div class="wrap">
        <div class="now__head" data-reveal>
          <p class="kicker now__kicker">What I'm doing now</p>
          <h2 class="now__title">Where my time goes.</h2>
        </div>

        <ul class="grid">
          {
            now.map((item, i) => {
              const Tag = item.href ? 'a' : 'div';
              const linkProps = item.external
                ? { href: item.href, target: '_blank', rel: 'noopener noreferrer' }
                : item.href
                  ? { href: item.href }
                  : {};
              return (
                <li>
                  <Tag
                    class:list={['card', { 'card--link': item.href }]}
                    data-reveal
                    data-reveal-delay={Math.min(i + 1, 4)}
                    {...linkProps}
                  >
                    <span class="card__n">{item.n}</span>
                    <h3 class="card__title">{item.title}</h3>
                    <p class="card__text">{item.text}</p>
                    <span class="card__meta">
                      {item.meta}
                      {item.href && (
                        <span class="card__arrow" aria-hidden="true">&#8594;</span>
                      )}
                    </span>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    {/* ---------- ABOUT SNAPSHOT ---------- */}
    <section class="snap section">
      <div class="wrap">
        <div class="snap__inner">
          <p class="kicker snap__kicker" data-reveal>A bit of background</p>
          <p class="snap__text" data-reveal data-reveal-delay="1">
            I got into public service by showing up. Three years ago I started
            going to Schalmont board meetings because my daughter's kindergarten
            class was too big. I kept showing up. Eventually I ran.
          </p>
          <a href="/about" class="snap__link" data-reveal data-reveal-delay="2">
            Read the whole story
            <span class="snap__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    background: var(--ink);
    color: var(--on-dark);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-block: clamp(2.5rem, 2rem + 2.5vw, 4.5rem);
  }
  .hero__photo {
    width: clamp(150px, 22vw, 248px);
    flex-shrink: 0;
  }
  .hero__photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: var(--radius);
  }
  .hero__kicker {
    color: var(--green-bright);
    margin-bottom: 0.85rem;
  }
  .hero__name {
    font-size: clamp(2.4rem, 1.7rem + 2.7vw, 3.4rem);
    letter-spacing: -0.022em;
  }
  .hero__lede {
    margin-top: 0.95rem;
    max-width: 40ch;
    font-size: 1.18rem;
    line-height: 1.5;
    color: var(--on-dark-soft);
  }

  /* ---------- NOW ---------- */
  .now { background: var(--paper); }
  .now__head {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
  }
  .now__kicker { color: var(--green); }
  .now__title {
    font-size: clamp(1.6rem, 1.3rem + 1.3vw, 2.1rem);
  }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    color: var(--text);
    transition:
      transform 0.22s var(--ease),
      border-color 0.22s var(--ease),
      box-shadow 0.22s var(--ease);
  }
  .card--link:hover {
    transform: translateY(-3px);
    border-color: var(--green);
    box-shadow: 0 14px 30px rgba(29, 34, 71, 0.1);
  }
  .card__n {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--green);
    margin-bottom: 0.7rem;
  }
  .card__title {
    font-size: 1.32rem;
    margin-bottom: 0.45rem;
  }
  .card__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--text-soft);
  }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.15rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .card__arrow {
    transition: transform 0.22s var(--ease);
    color: var(--green);
    font-size: 1rem;
  }
  .card--link:hover .card__arrow { transform: translateX(0.25rem); }
  .card--link:hover .card__meta { color: var(--green); }

  /* ---------- ABOUT SNAPSHOT ---------- */
  .snap { background: var(--paper); }
  .snap__inner {
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .snap__kicker {
    color: var(--green);
    margin-bottom: 1.1rem;
  }
  .snap__text {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.15rem + 1.1vw, 2rem);
    line-height: 1.34;
    letter-spacing: -0.015em;
    color: var(--text);
    max-width: var(--measure);
  }
  .snap__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.6rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--green);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid currentColor;
  }
  .snap__arrow { transition: transform 0.22s var(--ease); }
  .snap__link:hover .snap__arrow { transform: translateX(0.3rem); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 680px) {
    .hero__inner {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: 1.4rem;
    }
    .grid { grid-template-columns: 1fr; }
  }
</style>
