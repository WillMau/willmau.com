---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const icons = {
  mauops:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6.5" r="2.4"/><circle cx="18" cy="8.5" r="2.4"/><circle cx="9" cy="18" r="2.4"/><path d="M8.3 7.2l7.4 1M7.4 8.2l1.2 7.4M10.9 16.7l5.5-6"/></svg>',
  board:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M12 3l8 4.5H4L12 3zM6 9.5V18M10 9.5V18M14 9.5V18M18 9.5V18"/></svg>',
  scouting:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2.2 4.8L8.5 15.5l2.2-4.8L15.5 8.5z"/></svg>',
  resume:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4M9.5 12.5h5M9.5 16h5"/></svg>',
};

const now = [
  {
    n: '01',
    icon: 'mauops',
    title: 'Mauops',
    text: 'AI agents and consulting that help small businesses do more with the team they already have.',
    meta: 'mauops.com',
    href: 'https://mauops.com',
  },
  {
    n: '02',
    icon: 'board',
    title: 'Schalmont School Board',
    text: 'Elected trustee in 2023, reelected in 2026 to a second term on the Board of Education.',
    meta: 'Follow on Facebook',
    href: 'https://www.facebook.com/people/Will-Mau-for-Schalmont-Board-of-Education/61567429940268/',
  },
  {
    n: '03',
    icon: 'scouting',
    title: 'Scouting',
    text: 'Committee chair for the Scout troop that meets at Jefferson Elementary in Rotterdam.',
    meta: 'troop3054.org',
    href: 'https://www.troop3054.org',
  },
  {
    n: '04',
    icon: 'resume',
    title: 'Résumé',
    text: 'Experience, education, and civic work, on one page you can read or download.',
    meta: 'On this site',
    href: '/resume',
  },
];
---

<Base
  title="Will Mau — Rotterdam, New York"
  description="Will Mau of Rotterdam, New York. School board member at Schalmont Central School District and founder of Mauops."
>
  <main id="main">
    {/* ---------- INTRO ---------- */}
    <section class="intro">
      <SiteHeader />
      <div class="wrap intro__inner">
        <p class="kicker intro__kicker" data-reveal>Rotterdam, New York</p>
        <h1 class="intro__name" data-reveal data-reveal-delay="1">Will Mau</h1>
        <p class="intro__lede" data-reveal data-reveal-delay="2">
          School board member at Schalmont Central School District and
          founder of Mauops, an AI consulting practice. Born and raised in
          Rotterdam, New York.
        </p>
      </div>
    </section>

    {/* ---------- NOW ---------- */}
    <section class="now section" id="now">
      <div class="wrap">
        <div class="now__head" data-reveal>
          <h2 class="now__title">What I'm doing now</h2>
          <p class="now__hint">Hover a card</p>
        </div>

        <ul class="grid">
          {
            now.map((item, i) => {
              const external = item.href.startsWith('http');
              return (
                <li class="flip">
                  <a
                    class="flip__inner"
                    href={item.href}
                    data-reveal
                    data-reveal-delay={Math.min(i + 1, 4)}
                    {...(external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                  >
                    <span class="flip__face flip__front">
                      <span class="flip__n">{item.n}</span>
                      <span class="flip__icon" set:html={icons[item.icon]} />
                      <span class="flip__title">{item.title}</span>
                    </span>
                    <span class="flip__face flip__back">
                      <span class="flip__text">{item.text}</span>
                      <span class="flip__cta">
                        {item.meta}
                        <span class="flip__arrow" aria-hidden="true">&#8594;</span>
                      </span>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>

    {/* ---------- ABOUT SNAPSHOT ---------- */}
    <section class="snap section">
      <div class="wrap">
        <div class="snap__inner">
          <p class="kicker snap__kicker" data-reveal>A bit of background</p>
          <p class="snap__text" data-reveal data-reveal-delay="1">
            I got into public service by showing up. Three years ago I started
            going to Schalmont board meetings because my daughter's kindergarten
            class was too big. I kept showing up. Eventually I ran.
          </p>
          <a href="/about" class="snap__link" data-reveal data-reveal-delay="2">
            Read the whole story
            <span class="snap__arrow" aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /* ---------- INTRO ---------- */
  .intro {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .intro__inner {
    padding-block: clamp(1rem, 0.7rem + 1.4vw, 2.25rem)
      clamp(2.75rem, 2.2rem + 2.6vw, 4.5rem);
  }
  .intro__kicker {
    color: var(--green);
    margin-bottom: 0.65rem;
  }
  .intro__name {
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4rem);
    color: var(--ink);
    line-height: 1;
  }
  .intro__lede {
    margin-top: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    max-width: 34ch;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.2rem, 1.05rem + 0.7vw, 1.5rem);
    line-height: 1.4;
    color: var(--text);
  }

  /* ---------- NOW ---------- */
  .now { background: var(--paper); }
  .now__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1.4rem, 1.1rem + 1.3vw, 2.2rem);
  }
  .now__title {
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2rem);
    color: var(--ink);
  }
  .now__hint {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
    white-space: nowrap;
  }

  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem;
  }

  /* ---------- FLIP CARD ---------- */
  .flip { perspective: 1400px; }
  .flip__inner {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(210px, 11rem + 7vw, 250px);
    transform-style: preserve-3d;
    transition: transform 0.55s var(--ease);
  }
  .flip__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: var(--radius);
    padding: clamp(1.3rem, 1rem + 1vw, 1.85rem);
    display: flex;
    flex-direction: column;
  }
  .flip__front {
    background: var(--paper-pure);
    border: 1px solid var(--line);
    color: var(--text);
  }
  .flip__back {
    background: var(--ink);
    color: var(--on-dark);
    transform: rotateY(180deg);
  }
  .flip__n {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--green);
  }
  .flip__icon {
    margin-top: auto;
    color: var(--green);
  }
  .flip__icon :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
  }
  .flip__title {
    margin-top: 0.85rem;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.32rem;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .flip__text {
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--on-dark);
  }
  .flip__cta {
    margin-top: auto;
    padding-top: 1rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-bright);
  }
  .flip__arrow { transition: transform 0.22s var(--ease); }

  @media (hover: hover) {
    .flip__inner:hover { transform: rotateY(180deg); }
    .flip__inner:hover .flip__arrow { transform: translateX(0.25rem); }
    .flip__inner:focus-visible { transform: rotateY(180deg); }
  }

  /* Touch devices: no hover, so stack the two faces into one static card */
  @media (hover: none) {
    .flip__inner { height: auto; }
    .flip__face {
      position: static;
      backface-visibility: visible;
      transform: none;
    }
    .flip__front {
      border-radius: var(--radius) var(--radius) 0 0;
      border-bottom: 0;
    }
    .flip__back {
      background: var(--paper-pure);
      color: var(--text);
      border: 1px solid var(--line);
      border-top: 0;
      border-radius: 0 0 var(--radius) var(--radius);
    }
    .flip__text { color: var(--text-soft); }
    .flip__cta { color: var(--green); }
  }

  /* ---------- SNAPSHOT ---------- */
  .snap { background: var(--paper); }
  .snap__inner {
    border-top: 1px solid var(--line);
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.75rem);
  }
  .snap__kicker {
    color: var(--green);
    margin-bottom: 1rem;
  }
  .snap__text {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 1.95rem);
    line-height: 1.36;
    letter-spacing: -0.012em;
    color: var(--ink);
    max-width: var(--measure);
  }
  .snap__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--green);
    padding-bottom: 0.2rem;
    border-bottom: 2px solid currentColor;
  }
  .snap__arrow { transition: transform 0.22s var(--ease); }
  .snap__link:hover .snap__arrow { transform: translateX(0.3rem); }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 620px) {
    .grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flip__inner { transition: none; }
  }
</style>
