---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const principles = [
  {
    title: 'Diagnose before you build',
    text: 'Most operations problems are definition problems, not tool problems. A few hours with the actual data (the tickets, the lost-deal notes, the funnel report) and the right system falls out of the diagnosis.',
  },
  {
    title: 'Build what should be built, buy what shouldn’t',
    text: 'One vendor quoted $90K a year for what a 200-line script does better at about $20 a month. When a vendor solves it cleanly, buy. When it doesn’t, direct the internal build.',
  },
  {
    title: 'Make it boring to operate',
    text: 'Every system ships with a deployment guide, a backfill guide, and a what-to-do-when-it-breaks guide. The job is not to be the only person who understands how it works.',
  },
  {
    title: 'Leave the team faster than you found it',
    text: 'Operations should not just add reporting overhead. Anything I build has to give the team time back, or it should not ship.',
  },
];

const initiatives = [
  {
    stat: '68%',
    statLabel: 'of support tickets auto-handled',
    title: 'AI case-handling system',
    summary:
      'An Azure OpenAI agent reads incoming support cases, classifies them, and resolves routine ones (passcode resets, registration changes, license lookups) end to end.',
    detail:
      'The system auto-handles about 68% of incoming cases at roughly $4 a month in API costs, and writes a structured handoff for cases that need a human. The most visible outcome: the support team scaled from 6 people to 3, with response time improving rather than degrading.',
  },
  {
    stat: '10 sec',
    statLabel: 'from new lead to first-touch email',
    title: 'AI lead-triage system',
    summary:
      'Every inbound lead is auto-classified and answered with a personalized first-touch email in about ten seconds, live in production.',
    detail:
      'Before approving the build, I directed a study of 1,064 converted leads over 24 months to find what actually predicts conversion. The system now classifies roughly 600 leads a month, suppresses about 11% as junk before a VP sees them, and reclaims an estimated 50 to 100 hours of manual triage monthly across five regional VPs.',
  },
  {
    stat: '95%',
    statLabel: 'Apex test coverage, running weekly',
    title: 'Executive forecasting platform',
    summary:
      'A snapshot system that gives TalentSmartEQ its first reliable year-over-year view of pipeline, quota performance, and deal history.',
    detail:
      'Salesforce stores opportunities as single mutable rows, so history evaporates the moment a stage changes. I directed a custom snapshot object, an Apex batch that runs every Monday at 5 AM, a 95%-coverage test suite, and a Lightning Web Component executive dashboard. It has run weekly since early 2026 with no manual intervention.',
  },
  {
    stat: '100s',
    statLabel: 'of cross-team hours saved per year',
    title: 'Clickwrap legal re-architecture',
    summary:
      'A multi-round editing, approval, and signature cycle for every new customer agreement, collapsed into a single-click workflow.',
    detail:
      'Legal still owns the underlying contract template, but each new agreement now flows through automation instead of email chains, reclaiming hundreds of hours annually across legal, sales, and operations and shortening the path from interested customer to signed agreement.',
  },
  {
    stat: 'Daily',
    statLabel: 'who-to-call list for the sales team',
    title: 'Customer-health system',
    summary:
      'A daily report that surfaces which customers are low on assessment credits, which inventory is stagnant, and how fast each account is burning credits.',
    detail:
      'The data lived in the assessment platform; the customer relationship lived in Salesforce, and nobody was joining them. The system now computes reorder opportunities and churn risk every day and emits a one-page report with one-click outreach buttons that sales opens like a dashboard.',
  },
  {
    stat: '0',
    statLabel: 'humans left in the integration',
    title: 'Accounts Receivable automation',
    summary:
      'A manual AR workbook, updated by hand from purchase exports, rebuilt as an automated pipeline.',
    detail:
      'A daily job pulls every account’s payment terms from Salesforce, authenticates to Microsoft Graph through a service principal, and posts a clean CSV to SharePoint. A documented runbook means anyone on the team can run collections, not just one person.',
  },
];

const experience = [
  {
    logo: '/logos/talentsmart.png',
    mark: 'TS',
    role: 'Vice President of Operations',
    org: 'TalentSmartEQ',
    dates: 'May 2021 to Present',
    place: 'Remote',
    text: 'Operations and technology leadership for a remote-first emotional-intelligence training company, as one of four members of the Executive Leadership Team.',
    bullets: [
      'Partner directly with the CEO on company strategy and operating cadence.',
      'Lead a global team: a U.S. customer-support group, a development team in India, and support desks in Mexico and Guatemala.',
      'Own revenue operations, technology infrastructure, data privacy, cybersecurity, vendor management, and contract management.',
      'Replaced manual spreadsheet work across the company with documented, tested systems and production AI agents.',
      'Promoted from Director of Sales Operations to Sr. Director of Operations to Vice President.',
    ],
  },
  {
    logo: '/logos/cengage.png',
    mark: 'CL',
    role: 'Senior Sales Manager, Professional & Academic Channel',
    org: 'Cengage',
    dates: 'Mar 2018 to May 2021',
    place: 'Clifton Park, NY',
    text: 'Sales operations leadership for a B2B channel of one of the largest education publishers in North America.',
    bullets: [
      'Drove an enterprise Salesforce implementation that delivered a 10x productivity gain in six months.',
      'Designed the KPI frameworks and compensation models that aligned incentives to revenue targets.',
      'Built a sales enablement and onboarding program that cut new-hire ramp from eight months to four weeks.',
      'Directed territory planning and segmentation, increasing pipeline conversion.',
      'Partnered with Marketing and Product to refine go-to-market plays and funnel quality.',
    ],
  },
  {
    logo: '/logos/charter.png',
    mark: 'CC',
    role: 'Manager, Inbound Sales',
    org: 'Charter Communications',
    dates: 'Jan 2014 to Mar 2018',
    place: 'Albany, NY',
    text: 'Frontline sales leadership for a regional telecommunications provider, across inbound sales and sales effectiveness.',
    bullets: [
      'Directed inbound sales strategy and team operations, lifting performance metrics and revenue.',
      'Redesigned sales processes around CRM tooling to improve efficiency and customer engagement.',
      'Built a peer-mentorship program; the team reached top-ranked status in the enterprise.',
      'Led a sales training program that improved sales metrics 9% and cut average handle time by 72 seconds.',
      'Promoted from Supervisor to Manager of Sales Effectiveness to Manager of Inbound Sales.',
    ],
  },
  {
    logo: '/logos/tjx.png',
    mark: 'TJX',
    role: 'Operations Manager',
    org: 'TJX',
    dates: 'Jun 2013 to Jan 2014',
    place: 'Clifton Park, NY',
    text: 'Operations leadership for a combined Marshalls and HomeGoods store: human resources, logistics, and customer experience.',
    bullets: [
      'Revamped training protocols and ended the store’s decade-long shrinkage problem.',
      'Turned a 50% staffing shortage into a consistent 5% surplus through targeted hiring and placement.',
      'Reallocated resources to strengthen logistics, store turnover, and profitability.',
      'Held audit and compliance standards that consistently passed external audits.',
    ],
  },
  {
    logo: '/logos/target.png',
    mark: 'TG',
    role: 'Executive Team Leader',
    org: 'Target',
    dates: 'Oct 2010 to Jun 2013',
    place: 'Clifton Park, NY',
    text: 'Sales floor and logistics leadership for a major retail store, directing a team of more than 120.',
    bullets: [
      'Grew store revenue from $32M to $36M over two years.',
      'Boosted average transaction value by more than $5.',
      'Directed a 120-plus-person team with development programs that promoted internal advancement.',
      'Drove the store to top company rankings across multiple performance metrics.',
    ],
  },
  {
    logo: '/logos/schenectady.png',
    mark: 'SCS',
    role: 'Social Studies Teacher',
    org: 'Schenectady High School',
    dates: 'Aug 2007 to Sep 2010',
    place: 'Schenectady, NY',
    text: 'Taught secondary social studies, integrating technology into the curriculum and leading an after-school program.',
    bullets: [
      'Built a social studies curriculum with methods that lifted student engagement and performance.',
      'Integrated technology into instruction and secured business donations for classroom computing.',
      'Directed an after-school program and supported professional development for veteran teachers.',
    ],
  },
];

const skillGroups = [
  {
    label: 'Platforms',
    desc: 'The systems I administer and architect.',
    items: [
      'Salesforce (Apex, LWC, SOQL, Flow, Pardot)',
      'Microsoft 365',
      'SharePoint',
      'Azure',
      'Microsoft Graph',
    ],
  },
  {
    label: 'Hands-on',
    desc: 'I write the code when that is the right call.',
    items: [
      'Python (pandas, simple-salesforce)',
      'Apex (batch, triggers, 95% test coverage)',
      'Lightning Web Components',
      'TypeScript & Astro',
      'SQL',
      'Git & GitHub Actions',
    ],
  },
  {
    label: 'AI & LLM',
    desc: 'Production AI, built carefully.',
    items: [
      'Azure OpenAI',
      'Structured-output classification',
      'RAG patterns',
      'Shadow-mode deployment',
      'Human-in-the-loop audit',
    ],
  },
];

const offerings = [
  {
    dur: '1 to 2 weeks',
    title: 'Salesforce & RevOps Health Check',
    text: 'A diagnostic pass on the CRM and revenue stack, ending in a prioritized fix list.',
  },
  {
    dur: '2 weeks',
    title: 'Funnel Bottleneck Sprint',
    text: 'Find where the funnel leaks, then build and ship the fix.',
  },
  {
    dur: '1 week',
    title: 'Executive Dashboard Pack',
    text: 'The reporting leadership actually needs, built and documented to hand off.',
  },
];

const education = [
  {
    role: 'M.A., American History',
    org: 'University at Albany',
    note: '2007 to 2010 · 4.0 GPA',
  },
  {
    role: 'B.A., History, Political Science & Education',
    org: 'The College of Saint Rose',
    note: '2003 to 2007 · 3.6 GPA · Student Association President',
  },
];

const certifications = [
  'Salesforce Certified Administrator',
  'Foundations of Project Management',
  'Mastering Emotional Intelligence, Levels 1 & 2',
  'New York State Teacher Certification, Social Studies 7-12',
  'Marquis Who’s Who Honored Listee',
];

const civic = [
  {
    role: 'Elected Board of Education Member',
    org: 'Schalmont Central School District',
    dates: '2024 to present',
    text: 'Elected in 2023 and reelected in 2026. Two years of work including Pre-K expansion, the Woestina school reopening, a Residential Trade Technology program, and a 1.95% tax levy held well under the state cap.',
  },
  {
    role: 'Troop Committee Chair',
    org: 'Scouting America, Troop 3054',
    dates: '2024 to present',
    text: 'Chair the troop committee: strategic planning, adult-leader development, and community engagement. Also built and maintain the troop website.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Will Mau',
  alternateName: 'William Mau',
  jobTitle: 'Vice President of Operations',
  worksFor: { '@type': 'Organization', name: 'TalentSmartEQ' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rotterdam',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'University at Albany' },
    { '@type': 'CollegeOrUniversity', name: 'The College of Saint Rose' },
  ],
  url: 'https://willmau.com/resume',
  sameAs: ['https://www.linkedin.com/in/will-mau/', 'https://mauops.com'],
};
---

<Base
  title="Will Mau, Operations & Technology Executive | Résumé"
  description="The résumé of Will Mau: Vice President of Operations at TalentSmartEQ, fifteen-plus years across operations, revenue systems, and AI automation. Salesforce certified. Rotterdam, New York."
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <main id="main">
    {/* ---------- HERO ---------- */}
    <section class="r-hero">
      <SiteHeader />
      <div class="wrap r-hero__inner">
        <p class="kicker r-hero__kicker" data-reveal>Résumé</p>
        <h1 class="r-hero__name" data-reveal data-reveal-delay="1">Will Mau</h1>
        <p class="r-hero__role" data-reveal data-reveal-delay="1">
          Operations &amp; Technology Executive &middot; AI &amp; Automation
        </p>
        <p class="r-hero__summary" data-reveal data-reveal-delay="2">
          I am an operations executive who builds the systems most VPs only
          buy. Fifteen-plus years across operations, revenue, and business
          technology. Currently VP of Operations at TalentSmartEQ and one of
          four members of its Executive Leadership Team.
        </p>
        <div class="r-hero__actions" data-reveal data-reveal-delay="3">
          <a class="r-btn" href="https://www.linkedin.com/in/will-mau/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.5 0H12v1.92h.06c.6-1.13 2.06-2.32 4.24-2.32 4.54 0 5.38 2.99 5.38 6.87V22h-4.56v-6.69c0-1.6-.03-3.66-2.23-3.66-2.23 0-2.57 1.74-2.57 3.54V22H7.72V8z"/></svg>
            View on LinkedIn
          </a>
          <a class="r-btn" href="/will-mau-resume.pdf" download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14"/></svg>
            Download PDF
          </a>
          <a class="r-btn" href="mailto:William.Mau@gmail.com">Email</a>
        </div>
      </div>
    </section>

    {/* ---------- HOW I LEAD ---------- */}
    <section class="section r-section">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>How I lead</h2>
        <div class="r-principles">
          {
            principles.map((p, i) => (
              <div class="r-principle" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <h3 class="r-principle__title">{p.title}</h3>
                <p class="r-principle__text">{p.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- SELECTED WORK ---------- */}
    <section class="section r-section r-section--alt">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Selected work</h2>
        <p class="r-lede" data-reveal>
          A sample of the systems I have designed and shipped at
          TalentSmartEQ.
        </p>
        <div class="r-work">
          {
            initiatives.map((it, i) => (
              <article class="r-card" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <div class="r-card__stat">
                  <span class="r-card__num">{it.stat}</span>
                  <span class="r-card__statlabel">{it.statLabel}</span>
                </div>
                <h3 class="r-card__title">{it.title}</h3>
                <p class="r-card__summary">{it.summary}</p>
                <details class="r-card__more">
                  <summary>The full story</summary>
                  <p>{it.detail}</p>
                </details>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- EXPERIENCE ---------- */}
    <section class="section r-section">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Experience</h2>
        <div class="r-xp">
          {
            experience.map((x, i) => (
              <div class="r-xp__item" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <span class="r-xp__tile" aria-hidden="true">
                  {x.logo ? (
                    <img src={x.logo} alt="" loading="lazy" />
                  ) : (
                    <span class="r-xp__mono">{x.mark}</span>
                  )}
                </span>
                <div class="r-xp__body">
                  <div class="r-xp__head">
                    <h3 class="r-xp__role">{x.role}</h3>
                    <span class="r-xp__dates">{x.dates}</span>
                  </div>
                  <p class="r-xp__org">{x.org} &middot; {x.place}</p>
                  <p class="r-xp__text">{x.text}</p>
                  {x.bullets && (
                    <details class="r-xp__more">
                      <summary>Highlights</summary>
                      <ul class="r-xp__bullets">
                        {x.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    </details>
                  )}
                </div>
              </div>
            ))
          }
        </div>
        <a
          class="r-linkedin"
          href="https://www.linkedin.com/in/will-mau/"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
        >
          <span>The complete history, with recommendations, is on LinkedIn.</span>
          <span class="r-linkedin__arrow" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </section>

    {/* ---------- INDEPENDENT PRACTICE ---------- */}
    <section class="section r-section r-section--alt">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Independent practice</h2>
        <p class="r-lede" data-reveal>
          Alongside the work at TalentSmartEQ, I run Mauops, a solo
          Salesforce, AI, and automation consultancy. Most small businesses
          are paying for software they barely use and doing by hand what
          should be automated. The same approach fixes that.
        </p>
        <div class="r-offerings">
          {
            offerings.map((o, i) => (
              <div class="r-offering" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <span class="r-offering__dur">{o.dur}</span>
                <h3 class="r-offering__title">{o.title}</h3>
                <p class="r-offering__text">{o.text}</p>
              </div>
            ))
          }
        </div>
        <a
          class="r-linkedin"
          href="https://mauops.com"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
        >
          <span>Recent engagements and fixed-scope offerings at mauops.com</span>
          <span class="r-linkedin__arrow" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </section>

    {/* ---------- TECHNOLOGY ---------- */}
    <section class="section r-section">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Technology</h2>
        <p class="r-lede" data-reveal>
          An executive with enough technical fluency to architect solutions,
          evaluate vendors honestly, and direct technical work without
          translation overhead.
        </p>
        <div class="r-skills">
          {
            skillGroups.map((g, i) => (
              <div class="r-skillgroup" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <p class="r-skillgroup__label">{g.label}</p>
                <p class="r-skillgroup__desc">{g.desc}</p>
                <ul class="r-tags">
                  {g.items.map((s) => <li class="r-tag">{s}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- EDUCATION + CIVIC ---------- */}
    <section class="section r-section r-section--alt">
      <div class="wrap r-grid2">
        <div data-reveal>
          <h2 class="r-h2">Education</h2>
          {
            education.map((e) => (
              <div class="r-edu">
                <p class="r-edu__role">{e.role}</p>
                <p class="r-edu__org">{e.org} &middot; {e.note}</p>
              </div>
            ))
          }
          <h3 class="r-subh">Certifications</h3>
          <ul class="r-tags">
            {certifications.map((c) => <li class="r-tag">{c}</li>)}
          </ul>
        </div>
        <div data-reveal data-reveal-delay="1">
          <h2 class="r-h2">Civic &amp; community</h2>
          {
            civic.map((c) => (
              <div class="r-edu">
                <p class="r-edu__role">{c.role}</p>
                <p class="r-edu__org">{c.org} &middot; {c.dates}</p>
                <p class="r-edu__text">{c.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Base>

<style>
  /* ---------- HERO ---------- */
  .r-hero {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .r-hero__inner {
    padding-block: clamp(1.25rem, 0.9rem + 1.5vw, 2.5rem)
      clamp(2.75rem, 2.2rem + 2.6vw, 4.25rem);
  }
  .r-hero__kicker { color: var(--green); margin-bottom: 0.6rem; }
  .r-hero__name {
    font-size: clamp(2.5rem, 1.9rem + 2.8vw, 3.75rem);
    color: var(--ink);
    line-height: 1;
  }
  .r-hero__role {
    margin-top: 0.6rem;
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green);
  }
  .r-hero__summary {
    margin-top: 1.1rem;
    max-width: 56ch;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.32rem);
    line-height: 1.45;
    color: var(--text);
  }
  .r-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  .r-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-pure);
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 700;
    transition: border-color 0.18s var(--ease), transform 0.18s var(--ease);
  }
  .r-btn:hover { border-color: var(--green); transform: translateY(-2px); }
  .r-btn--solid {
    background: var(--ink);
    color: var(--on-dark);
    border-color: var(--ink);
  }
  .r-btn--solid:hover { background: var(--ink-deep); border-color: var(--ink-deep); }
  .r-btn svg { width: 1rem; height: 1rem; color: var(--green-bright); }

  /* ---------- SECTIONS ---------- */
  .r-section--alt { background: var(--paper-pure); }
  .r-h2 {
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.1rem);
    color: var(--ink);
    margin-bottom: 1.4rem;
  }
  .r-subh {
    font-size: 1.15rem;
    color: var(--ink);
    margin: 2rem 0 0.9rem;
  }
  .r-lede {
    max-width: 56ch;
    color: var(--text-soft);
    margin-bottom: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    margin-top: -0.5rem;
  }

  /* ---------- PRINCIPLES ---------- */
  .r-principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .r-principle {
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.3rem, 1rem + 1vw, 1.85rem);
  }
  .r-principle__title {
    font-size: 1.18rem;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .r-principle__text {
    font-size: 0.99rem;
    line-height: 1.58;
    color: var(--text-soft);
  }

  /* ---------- SELECTED WORK ---------- */
  .r-work {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .r-card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
  }
  .r-section--alt .r-card { background: var(--paper); }
  .r-card__stat {
    display: flex;
    flex-direction: column;
    padding-bottom: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .r-card__num {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(2.4rem, 1.9rem + 1.8vw, 3.1rem);
    line-height: 1;
    color: var(--green);
    letter-spacing: -0.02em;
