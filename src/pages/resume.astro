---

<Base
  title="Will Mau, Operations & Technology Executive | Résumé"
  description="Will Mau, VP of Operations and Executive Leadership Team member at TalentSmartEQ. 15+ years building revenue and AI systems at growth-stage companies. Salesforce certified. Rotterdam, NY."
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(breadcrumbs)}
  />

  <main id="main">
    {/* ---------- HERO ---------- */}
    <section class="r-hero">
      <SiteHeader />
      <div class="wrap r-hero__inner">
        <p class="kicker r-hero__kicker" data-reveal>Résumé</p>
        <h1 class="r-hero__name" data-reveal data-reveal-delay="1">Will Mau</h1>
        <p class="r-hero__role" data-reveal data-reveal-delay="1">
          Operations &amp; Technology Executive &middot; AI &amp; Automation &middot; Revenue Systems
        </p>
        <p class="r-hero__summary" data-reveal data-reveal-delay="2">
          I am an operations executive who builds the systems most VPs only
          buy. Fifteen-plus years across operations, revenue, and business
          technology. Currently VP of Operations at TalentSmartEQ and one of
          four members of its Executive Leadership Team.
        </p>
        <div class="r-hero__actions" data-reveal data-reveal-delay="3">
          <a class="r-btn" href="https://www.linkedin.com/in/will-mau/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8h4.56v14H.22V8zm7.5 0H12v1.92h.06c.6-1.13 2.06-2.32 4.24-2.32 4.54 0 5.38 2.99 5.38 6.87V22h-4.56v-6.69c0-1.6-.03-3.66-2.23-3.66-2.23 0-2.57 1.74-2.57 3.54V22H7.72V8z"/></svg>
            View on LinkedIn
          </a>
          <a class="r-btn" href="/will-mau-resume.pdf" download>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4M5 19h14"/></svg>
            Download PDF
          </a>
          <a class="r-btn" href="mailto:William.Mau@gmail.com">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            Email
          </a>
        </div>
      </div>
    </section>

    {/* ---------- SELECTED WORK ---------- */}
    <section class="section r-section">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Selected work</h2>
        <p class="r-lede" data-reveal>
          A sample of the systems I have designed and shipped at
          TalentSmartEQ.
        </p>
        <div class="r-work">
          {
            initiatives.map((it, i) => (
              <article class="r-card" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <div class="r-card__stat">
                  <span class="r-card__num">{it.stat}</span>
                  <span class="r-card__statlabel">{it.statLabel}</span>
                </div>
                <h3 class="r-card__title">{it.title}</h3>
                <p class="r-card__summary">{it.summary}</p>
                <details class="r-card__more">
                  <summary>The full story</summary>
                  <p>{it.detail}</p>
                </details>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* ---------- HOW I LEAD ---------- */}
    <section class="section r-section r-section--alt">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>How I lead</h2>
        <ol class="r-principles">
          {
            principles.map((p, i) => (
              <li class="r-principle" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <span class="r-principle__n">{String(i + 1).padStart(2, '0')}</span>
                <div class="r-principle__body">
                  <h3 class="r-principle__title">{p.title}</h3>
                  <p class="r-principle__text">{p.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* ---------- EXPERIENCE ---------- */}
    <section class="section r-section">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Experience</h2>
        <div class="r-xp">
          {
            experience.map((x, i) => (
              <div class="r-xp__item" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <span class="r-xp__tile" aria-hidden="true">
                  {x.logo ? (
                    <img src={x.logo} alt="" loading="lazy" />
                  ) : (
                    <span class="r-xp__mono">{x.mark}</span>
                  )}
                </span>
                <div class="r-xp__body">
                  <div class="r-xp__head">
                    <h3 class="r-xp__role">{x.role}</h3>
                    <span class="r-xp__dates">{x.dates}</span>
                  </div>
                  <p class="r-xp__org">{x.org} &middot; {x.place}</p>
                  <p class="r-xp__text">{x.text}</p>
                  {x.bullets && (
                    <details class="r-xp__more">
                      <summary>Highlights</summary>
                      <ul class="r-xp__bullets">
                        {x.bullets.map((b) => <li>{b}</li>)}
                      </ul>
                    </details>
                  )}
                </div>
              </div>
            ))
          }
        </div>
        <a
          class="r-linkedin"
          href="https://www.linkedin.com/in/will-mau/"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
        >
          <span>The complete history, with recommendations, is on LinkedIn.</span>
          <span class="r-linkedin__arrow" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </section>

    {/* ---------- INDEPENDENT PRACTICE ---------- */}
    <section class="section r-section r-section--alt">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Independent practice</h2>
        <p class="r-lede" data-reveal>
          Alongside the work at TalentSmartEQ, I run Mauops, a solo
          Salesforce, AI, and automation consultancy. Most small businesses
          are paying for software they barely use and doing by hand what
          should be automated. The same approach fixes that.
        </p>
        <ul class="r-offerings">
          {
            offerings.map((o, i) => (
              <li class="r-offering" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <div class="r-offering__head">
                  <h3 class="r-offering__title">{o.title}</h3>
                  <span class="r-offering__dur">{o.dur}</span>
                </div>
                <p class="r-offering__text">{o.text}</p>
              </li>
            ))
          }
        </ul>
        <a
          class="r-linkedin"
          href="https://mauops.com"
          target="_blank"
          rel="noopener noreferrer"
          data-reveal
        >
          <span>Recent engagements and fixed-scope offerings at mauops.com</span>
          <span class="r-linkedin__arrow" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </section>

    {/* ---------- PUBLISHED WRITING ---------- */}
    <section class="section r-section r-section--alt">
      <div class="wrap">
        <h2 class="r-h2" data-reveal>Published writing</h2>
        <ul class="r-writing">
          {
            writing.map((w, i) => (
              <li class="r-writing__item" data-reveal data-reveal-delay={Math.min(i + 1, 4)}>
                <a class="r-writing__link" href={w.href} target="_blank" rel="noopener noreferrer">
                  <span class="r-writing__thumb">
                    <Image src={w.image} alt="" widths={[160, 240, 320]} sizes="120px" loading="lazy" />
                  </span>
                  <span class="r-writing__text">
                    <span class="r-writing__title">{w.title}</span>
