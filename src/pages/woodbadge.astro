const progress = (g: Goal) => {
  const done = g.rows.filter((r) => r.kind === 'done').length;
  return { done, total: g.rows.length, pct: Math.round((done / g.rows.length) * 100) };
};

const smartParts = [
  ['s', 'Specific'],
  ['m', 'Measurable'],
  ['a', 'Attainable'],
  ['r', 'Relevant'],
  ['t', 'Timely'],
] as const;

