    background: rgba(29, 34, 71, 0.04);
    padding: 0.65rem 0.9rem;
  }
  .wb-table td {
    padding: 0.75rem 0.9rem;
    border-top: 1px solid var(--line);
    vertical-align: top;
  }
  .wb-table td:first-child {
    font-weight: 600;
    color: var(--ink);
    width: 28%;
  }
  .wb-table td:last-child {
    width: 1%;
    white-space: nowrap;
  }

  .wb-table--quiet {
    background: transparent;
    border-style: dashed;
  }
  .wb-table--quiet td:first-child { font-weight: 500; }

  /* Numbers */
  .wb-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.75rem;
  }
  .wb-stat {
    padding: 0.85rem 1rem;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .wb-stat strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 1.2;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .wb-stat span {
    display: block;
    font-size: 0.84rem;
    line-height: 1.4;
    color: var(--text-soft);
    margin-top: 0.2rem;
  }

  .wb-path {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .wb-path li {
    padding: 0.5rem 0.3rem;
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-soft);
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-variant-numeric: tabular-nums;
  }
  .wb-path strong {
    display: block;
    font-size: 0.84rem;
    color: var(--ink);
  }
  .wb-path .wb-path__end {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--on-dark-soft);
  }
  .wb-path .wb-path__end strong { color: var(--on-dark); }

  /* Lists */
  .wb-list {
    padding-left: 1.2rem;
    font-size: 1rem;
    max-width: 68ch;
  }
  .wb-list li + li { margin-top: 0.45rem; }
  .wb-list li::marker { color: var(--green); }
  .wb-list strong { color: var(--ink); }

  /* Gallery */
  .wb-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }
  .wb-gallery figure { min-width: 0; }
  .wb-shot {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    cursor: zoom-in;
    transition: border-color 0.18s var(--ease);
  }
  /* Tall matches the portal's phone screenshots; whole shows a square flyer uncropped. */
  .wb-shot--tall { aspect-ratio: 6 / 7; }
  .wb-shot.wb-shot--whole :global(img) { object-fit: contain; }
  .wb-shot:hover { border-color: var(--green); }
  .wb-shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .wb-gallery figcaption {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-soft);
    margin-top: 0.45rem;
  }
  .wb-gallery figcaption strong { color: var(--ink); font-weight: 600; }

  .wb-request-note {
    font-size: 0.88rem;
    color: var(--text-soft);
    margin-top: 1rem;
    padding: 0.7rem 0.9rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    max-width: 68ch;
  }

  /* Feedback */
  .wb-note + .wb-note { margin-top: 1.4rem; }
  .wb-q {
    padding: 0.65rem 1rem;
    border-left: 3px solid var(--wb-tan);
    background: rgba(176, 149, 106, 0.09);
    border-radius: 0 8px 8px 0;
    max-width: 68ch;
  }
  .wb-q p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .wb-q .wb-q__who {
    font-family: var(--font-sans);
    font-style: normal;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 0.2rem;
  }

  /* Full SMART goal */
  .wb-smart {
    margin-top: 2rem;
    background: var(--paper-pure);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .wb-smart summary {
    cursor: pointer;
    padding: 0.9rem 1.15rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .wb-smart summary::marker { color: var(--green); }
  .wb-smart[open] summary { border-bottom: 1px solid var(--line); }
  .wb-smart dl { padding: 0.4rem 1.15rem 0; }
  .wb-smart > .wb-small { padding: 0 1.15rem 1.1rem; }
  .wb-smart__row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .wb-smart__row dt {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }
