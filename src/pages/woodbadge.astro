import newScoutNight from '../images/woodbadge/kit-adventureon.jpg';
import openHouseSign from '../images/woodbadge/kit-openhouse.jpg';
import packJoin from '../images/woodbadge/pack-join.jpg';
import packCrossover from '../images/woodbadge/pack-troop-crossover.jpg';
import portalProgram from '../images/woodbadge/portal-program.jpg';
import portalPlan from '../images/woodbadge/portal-plan.jpg';
import troopCalendar from '../images/woodbadge/troop-calendar-list.jpg';
import troopInvolved from '../images/woodbadge/troop-involved-positions.jpg';
import councilBoard from '../images/woodbadge/council-trained-board.jpg';
import troopHome from '../images/woodbadge/troop-home.jpg';
import troopGovernance from '../images/woodbadge/troop-governance.jpg';
import packCalendar from '../images/woodbadge/pack-calendar.jpg';
import packMobile from '../images/woodbadge/pack-home-mobile.jpg';
import woggleBeads from '../images/woodbadge/woggle-beads.png';
import regalia from '../images/woodbadge/wood-badge-regalia.jpg';
import gilwell1919 from '../images/woodbadge/gilwell-1919.jpg';

/*
  Every status on this page is a snapshot. When the work moves, update asOf
  and the rows. Rows are the pass conditions in each goal's approved
  measurable, and only they count toward the status cards; milestones show
  the process working but never count.
  Kept off this page on purpose: volunteer and family names, the troop's
  bank details, and reviewer names and contact information.
*/
const asOf = 'Oct 5, 2026';

type Kind = 'done' | 'pend' | 'sched';
interface Row { item: string; evidence: string; kind: Kind; status: string; href?: string }
interface Stat { value: string; label: string }
interface Point { lead?: string; text: string }
interface Shot { img: ImageMetadata; alt: string; title: string; text: string; tall?: boolean; whole?: boolean }
interface Note { who: string; said: string; answer: string }
interface Goal {
  id: string;
  n: number;
  title: string;
  short: string;
  due: string;
  badge: { kind: Kind; label: string };
  next: string;
  summary: string;
  smart: { s: string; m: string; a: string; r: string; t: string };
  rows: Row[];
  milestones?: { heading: string; rows: Row[] };
  stats?: { heading: string; items: Stat[]; after?: string };
  points?: { heading: string; items: Point[] };
  shots?: Shot[];
  onRequest?: string;
  notes: Note[];
  aside?: string;
}

const goals: Goal[] = [
  {
    id: 'recruiting',
    n: 1,
    title: 'Joint troop and pack recruiting process',
    short: 'Recruiting',
    due: 'Apr 30, 2027',
    badge: { kind: 'pend', label: 'Awaiting approvals' },
    next: 'Committee and pack Key 3 approvals next',
    summary: `Document a repeatable annual recruiting process run jointly by Troop 3054 and Pack 3054, and post it on the recruiting page of the troop portal.`,
    smart: {
      s: `I will write a repeatable annual recruiting process for the troop and the pack and publish it on the recruiting page of the Troop 3054 portal. It points every family into Scouting America's official join path, both units' BeAScout pins and Invitation Manager, and covers the fall sign-up, peer invitation our Scouts run themselves, and the crossover handoff from Arrow of Light into the troop. Constraint: no page of ours sits in the registration path or stores a lead, so nothing here leaves the units a tool to maintain.`,
      m: `This goal is complete when a repeatable annual recruiting process is documented and posted on the recruiting page of the Troop 3054 portal, with a named maintainer and an annual review date. Because it is a joint troop and pack plan, that requires it to be drafted and approved by the troop committee and by the pack's key three. Running the fall sign-up and one crossover-season event is how the process gets tested before it is posted.`,
      a: `Configuring the BeAScout pins and Invitation Manager is setup work inside my.scouting that I can do myself, and the writing is mine. Roadblocks: the pack has its own leadership and calendar and runs on its key three rather than a committee, and pack recruiting pays the troop back at crossover rather than this year. Mitigation is the Pack Minute already standing on our committee agenda as where this gets worked monthly, one named owner per unit, and getting the pack's approval in writing early rather than at the end.`,
      r: `A coordinated recruiting effort grows the pack and the troop together, and that protects the youth experience: more Scouts means more patrols, more real leadership jobs, and a program that can run. Membership is committee work and it decides whether either unit exists in ten years. In a district this size the pack is the troop's recruiting engine, so a troop-only plan is a plan to shrink slowly.`,
      t: `Process drafted by October 31, 2026. Both units' BeAScout pins verified and Invitation Manager in use by November 30, 2026. Fall sign-up run by December 31, 2026. Approved by the troop committee and the pack's key three by January 31, 2027. Crossover-season event run and the process posted to the portal's recruiting page by April 30, 2027.`,
    },
    rows: [
      { item: 'Repeatable annual process documented', evidence: `"Pack-to-Troop Recruiting Cycle": the path from Lion to First Class, ground rules, the year month by month, who does what, and the numbers to keep. The fall sign-up, peer invitation and the crossover handoff are written in as yearly steps.`, kind: 'done', status: 'Done Oct 2026' },
      { item: `Posted on the portal's recruiting page`, evidence: `my.troop3054.org Recruiting page, How it works tab. Marked "Draft for review" until both units approve, then marked adopted.`, kind: 'done', status: 'Posted as draft' },
      { item: 'Annual review date', evidence: `Every May, by each unit's Key 3 and the troop committee.`, kind: 'done', status: 'Set: May' },
      { item: 'Named maintainer', evidence: 'Named in the adoption motion.', kind: 'sched', status: 'Oct 14' },
      { item: 'Approved by the troop committee', evidence: 'Motion on the Oct 14 agenda.', kind: 'sched', status: 'Oct 14' },
      { item: `Approved by the pack's Key 3, in writing`, evidence: `Requested early, per the ticket's own mitigation. Covers the pack website too.`, kind: 'pend', status: 'Requested' },
    ],
    milestones: {
      heading: 'How the process gets tested',
      rows: [
        { item: 'National tools in place', evidence: `Both units' BeAScout pins set with online applications on, and Invitation Manager in use. troop3054.org/cubs and pack3054.org/join only forward to the pack's official my.Scouting application; no page of ours keeps a lead (checked Oct 5).`, kind: 'done', status: 'Done early' },
        { item: 'Fall sign-up', evidence: `Open house tables, a joint New Scout Night on Sept 21, a 24-post campaign, a welcome email to 49 families, and follow-up on open inquiries. Peer invitation is working too: a friend brought in by a troop Scout joined in October.`, kind: 'done', status: 'Ran fall 2026' },
        { item: 'Crossover-season step', evidence: 'In the process and planned: the Arrow of Light crossover at Blue & Gold, with troop Scouts running the bridge.', kind: 'sched', status: 'Planned, Mar 15' },
      ],
    },
    stats: {
      heading: 'What ran this fall',
      items: [
        { value: '31', label: 'Cubs registered in the pack (Oct 4)' },
        { value: '16', label: 'Families who started an application or asked' },
        { value: '8', label: 'Arrow of Light Scouts, the next crossover class' },
        { value: '8 → 5', label: 'New troop Scouts this year, still active in October' },
        { value: '14 → 15', label: 'Scouts in the troop, after a friend joined in October' },
      ],
    },
    points: {
      heading: 'What the fall taught us, now written into the process',
      items: [
        { text: 'The meeting time and place belong on everything. A parent who has to ask has already started looking for a reason not to come.' },
        { text: 'Seven applications sat at "Initiated" in my.Scouting, each on a countdown. Check Application Manager weekly in the fall.' },
        { text: 'Answer every inquiry within 24 hours. Three inquiries from August and September were still marked "Opened" in October.' },
        { text: 'At the Harvest Festival, troop Scouts taught at almost every station. That is the strongest recruiting picture either unit has.' },
        { text: 'Scouts recruit Scouts. In October a troop Scout invited a friend, and the friend joined: the peer invitation the ticket calls for, run by the Scouts themselves.' },
      ],
    },
    shots: [
      { img: recruitingHow, alt: 'Portal Recruiting page, How it works tab', title: 'The process in the portal.', text: 'Draft until both units vote.', tall: true },
      { img: recruitingYear, alt: 'Portal Recruiting page, This year tab', title: `This year's details.`, text: 'Set once; every post fills them in.', tall: true },
      { img: newScoutNight, alt: 'AdventureOn New Scout Night flyer for Sept 21', title: 'Joint New Scout Night,', text: 'Sept 21.', tall: true, whole: true },
      { img: openHouseSign, alt: 'Open house sign with a QR code to join Cub Scouts', title: 'Open house sign.', text: 'The QR code goes straight to the official application.', tall: true },
      { img: packJoin, alt: 'pack3054.org join page', title: 'pack3054.org/join.', text: 'Three steps, ending in the official application.' },
      { img: packCrossover, alt: 'pack3054.org page pointing Arrow of Light families to Troop 3054', title: 'The handoff, in public.', text: 'The pack site points Arrow of Light families to the troop.' },
    ],
    notes: [
      { who: 'Ticket counselor, Sept 2', said: 'Use national tools: the BeAScout pin is the join form, and applicants land in Invitation Manager. Invitation Manager is per unit, so use two unit lists and an agreed sharing rhythm.', answer: 'Done: both pins set, Invitation Manager in use, and one named owner in each unit who backs up the other (the pack and troop New Member Coordinators).' },
      { who: 'Ticket counselor, Sept 2', said: 'Knowledge management: where it lives, who edits, who maintains, what review cadence.', answer: `It lives on the portal's Recruiting page. The Webmaster, Committee Chair, Scoutmaster and New Member Coordinator can edit; other leaders can read and copy. It is reviewed every May.` },
    ],
  },
  {
    id: 'planning',
    n: 2,
    title: 'Annual program calendar, built by the PLC',
    short: 'Program calendar',
    due: 'May 31, 2027',
    badge: { kind: 'pend', label: 'Handoff underway' },
    next: 'Annual planning section next',
    summary: `Document an annual program planning procedure for the Patrol Leaders' Council, and prove it works with a Scout-built program year calendar posted to the troop portal.`,
    smart: {
      s: `I will write a short annual program planning procedure based on Scouting America's annual planning conference materials rather than something I invent, and coach the senior patrol leader through it one on one before it reaches the PLC. The Scoutmaster and I prepare, the senior patrol leader runs the conference, and the PLC picks the activities and puts a Scout's name on each. The PLC reviews each meeting it planned right after that meeting, so the procedure gets tested every few weeks rather than once a year. Constraint: youth-led does not mean unstructured, and the calendar the Scouts produce is a plan, not a contract.`,
      m: `This goal is complete when two things are posted to the Troop 3054 portal: the annual program planning procedure, revised from the PLC's own review of it, and the program year calendar the PLC produces at the annual planning conference using it, with a start time and a location on every event. Changes the Scouts make to that calendar afterward do not undo completion.`,
      a: `Writing the procedure is mine. Running the conference is theirs, which is the point. Roadblocks: adults filling silences out of habit, and a PLC that has not planned at this level before. Mitigation is agreeing with the Scoutmaster in advance on exactly what the committee stops doing, walking the senior patrol leader through the procedure beforehand rather than correcting him during the conference, and keeping the ask to a calendar rather than a fully worked plan for every event.`,
      r: `The committee had been doing the Scouts' planning for them, which is the patrol method backwards. A troop where the Scouts build the year gets a program they chose and a dozen of them get real practice at planning something and being held to it. This is the change I asked the committee to make for this program year, and it is worth nothing if it depends on me being in the room.`,
      t: `Handoff agreed with the Scoutmaster by October 31, 2026. Procedure drafted and the senior patrol leader walked through it by December 31, 2026. PLC's post-meeting review running by February 28, 2027. Annual planning conference held, the procedure revised from the PLC's feedback, and both it and the calendar posted to the portal by May 31, 2027.`,
    },
    rows: [
      { item: 'Planning procedure posted to the portal', evidence: `Meeting planning is written and posted: the "Planning Meetings (PLC)" section of the troop's app guide (troop3054.org/app.html) covers who writes plans, Scouting America's troop meeting plan with a Scout's name on each part, and the review after every meeting. The annual planning conference section is being added.`, kind: 'pend', status: 'In progress' },
      { item: `Procedure revised from the PLC's own review`, evidence: 'The PLC reviews the procedure after using it, and its changes go in before posting.', kind: 'sched', status: 'Spring 2027' },
      { item: `PLC's program-year calendar posted to the portal`, evidence: 'The calendar the PLC builds with the procedure.', kind: 'sched', status: 'By May 31' },
      { item: 'Start time and location on every event', evidence: `47 of the 60 events on the 2026-27 calendar have both, and the portal's Program page flags the rest. The PLC's own calendar needs both on every event.`, kind: 'pend', status: '47 of 60' },
    ],
    milestones: {
      heading: 'Milestones (not pass conditions)',
      rows: [
        { item: 'Handoff agreed with the Scoutmaster', evidence: 'Recorded in the Sept 2 committee minutes, posted on troop3054.org: "The committee affirmed the troop\'s move to a fully Scout-led model." Adults give feedback rather than plans.', kind: 'done', status: 'Sept 2' },
        { item: 'A place for the PLC to plan, in the portal', evidence: `A Plan card on every meeting and outing, built on Scouting America's troop meeting plan: each part of the meeting, duty patrol, the Scout who leads each part, uniform and what to bring.`, kind: 'done', status: 'Live Oct 5' },
        { item: 'Procedure drafted; SPL walked through it one on one', evidence: 'Meeting planning is drafted and posted; the annual planning section is next. Then the SPL walks through it one on one, before it reaches the PLC.', kind: 'pend', status: 'By Dec 31' },
        { item: `PLC's post-meeting review running`, evidence: `A three-line review after each event: what worked, what didn't, what to change. Next step: a PLC training night, with Scout sign-ins set up first.`, kind: 'pend', status: 'By Feb 28' },
        { item: 'Annual planning conference', evidence: `The SPL runs it; the PLC picks the activities and puts a Scout's name on each. The current calendar has 12 events still missing a time or place, the PLC's first calendar task.`, kind: 'sched', status: 'Spring 2027' },
      ],
    },
    stats: {
      heading: 'What the planning record shows today',
      items: [
        { value: '1 of 4', label: 'Next meetings planned (Oct 5)' },
        { value: '25 → 12', label: 'Events missing a time or place' },
        { value: '3', label: 'Events the PLC added: Trunk-or-Treat, Trail of Treats, Pyramid Lake campout' },
      ],
      after: 'The first meeting plan (Oct 5, Trailer Cleanout, Class B) was entered by the Committee Chair as the model. From the training night on, plans are written by the SPL, ASPL, patrol leaders, Troop Guide, Scribe and Quartermaster.',
    },
    shots: [
      { img: portalProgram, alt: 'Portal Program page', title: 'Program page.', text: `The PLC's planning dashboard: the next eight weeks, reviews waiting, events missing a time or place.`, tall: true },
      { img: portalPlan, alt: 'Meeting Plan card with times for each part', title: 'Plan card.', text: `Scouting America's meeting parts, with times.`, tall: true },
      { img: troopCalendar, alt: 'troop3054.org public calendar, list view', title: 'Public calendar.', text: 'Time and place on each event, fed live from the portal.' },
    ],
    notes: [
      { who: 'Course director, Sept 14', said: 'For Goal 2, do you plan a feedback cycle with the PLC to iterate and refine the plan and build alignment?', answer: 'Yes, built into the rhythm: the PLC reviews each meeting right after it happens, so the loop runs every few weeks instead of once a year. The review lives on the same Plan card, and the Program page shows any review still waiting. After the annual conference, the PLC reviews the procedure itself before it is posted.' },
      { who: 'Ticket counselor, Sept 2', said: `Don't over-delegate to youth. If you leave too much up to the kids they will default to less than is actually required for success.`, answer: `The plan template is Scouting America's, not a blank page: every meeting has the same parts, a time for each, and a Scout's name on each part.` },
    ],
  },
  {
    id: 'roles',
    n: 3,
    title: 'Adult roles and responsibilities matrix',
    short: 'Roles matrix',
    due: 'Jan 31, 2027',
    badge: { kind: 'pend', label: 'Vote pending' },
    next: 'Committee vote Oct 14 next',
    summary: 'Build a matrix of adult roles and responsibilities with named holders and backups, so the troop keeps operating through leadership changes and no single adult holds a job nobody else can do.',
    smart: {
      s: `I will document every key troop role and every shared responsibility that currently lives with one person: committee positions, social media administration, website and domain access, communications, bank account authorization and custody of key files. I will start from Scouting America's published position descriptions rather than my own wording, and confirm each entry one on one with the person holding it before it goes anywhere. Backups are asked individually rather than volunteered into in a meeting. Constraint: no passwords or credentials, only who holds access and how it transfers.`,
      m: `This goal is complete when the roles and responsibilities matrix is posted to the Troop 3054 portal with a named maintainer and adopted by recorded committee vote. Every role and every shared responsibility the committee identifies as single-point carries a named holder, a named backup wherever one has been found, and any remaining gap written down with someone owning the job of closing it. Adoption also sets the review rotation, one or two committee documents a year rather than all of them at once.`,
      a: `This is an inventory and a set of conversations, both within my reach as chair, and putting it to a vote is my own agenda, and the committee already votes on items using an abridged Robert's Rules, so adoption is an established practice rather than something new. Roadblocks: people are reluctant to be named as a backup, and some access is held by volunteers who have drifted away. Mitigation is the three-tier volunteer model, where backup is a small defined job rather than an open commitment.`,
      r: `The troop currently depends on a handful of adults and I am one of them. A troop that cannot survive my leaving is not a troop I have actually served, and every week lost to an adult handoff going badly is a week of program the Scouts do not get back.`,
      t: `Matrix drafted by November 30, 2026. Backups identified and confirmed by December 31, 2026. Adopted by recorded committee vote and published to the portal, with the review rotation set, by January 31, 2027.`,
    },
    rows: [
      { item: 'Matrix posted to the portal', evidence: `Roles & backups in the portal is the only place people get put on jobs. It feeds the public Get Involved page, so the website can't drift from the record.`, kind: 'done', status: 'Posted as draft' },
      { item: 'Named maintainer', evidence: 'Named in the adoption motion.', kind: 'sched', status: 'Oct 14' },
      { item: 'Adopted by recorded committee vote', evidence: 'Motion on the Oct 14 agenda.', kind: 'sched', status: 'Oct 14' },
      { item: 'A named holder for every role and single-point job', evidence: `Built from Scouting America's official position list. The Oct 4 positions sheet has 9 of 10 committee and Key 3 seats held, with the open seat covered by the Committee Chair until someone takes it; those holders still need entering in the portal, which feeds the public Get Involved page. Shared single-point jobs are listed by role: website and domain, app, calendar, Facebook and BAND (Webmaster); the bank account (Treasurer); records, key files and the committee email list (Secretary); recharter and my.Scouting (Committee Chair). Who holds access and how it transfers, never passwords.`, kind: 'pend', status: 'Portal update' },
      { item: 'A named backup wherever one has been found', evidence: 'Volunteer ask sent to all adult leaders, each backup confirmed one on one. 3 named so far.', kind: 'pend', status: 'In progress' },
      { item: 'Every remaining gap written down, with an owner', evidence: 'Every open seat and every role without a backup says what is at risk and who is working to close it.', kind: 'done', status: 'Written' },
      { item: 'Review rotation set at adoption', evidence: 'In the same motion: one or two committee documents reviewed each year.', kind: 'sched', status: 'Oct 14' },
    ],
    shots: [
      { img: troopInvolved, alt: 'troop3054.org Get Involved page, adult positions', title: 'Get Involved page.', text: 'Every position and where help is needed, pulled live from the portal.' },
      { img: councilBoard, alt: 'Twin Rivers Council 100% Trained Unit Board', title: '100% trained, both units.', text: 'Council board, Sept 2026. Pack 3054 and Troop 3054 are listed under Mohawk 03.' },
    ],
    onRequest: `The one-page positions summary and the portal's roles matrix name individual volunteers, so they are not shown here. Both are available on request.`,
    notes: [
      { who: 'Course director, Sept 14', said: 'Is there a plan to ensure alignment of the position descriptions before releasing it to the leaders?', answer: `Yes. Nobody is described in writing without seeing their own entry first. The descriptions start from Scouting America's published duties, so each conversation is "does this match what you actually do." Backups are asked individually, not volunteered into in a meeting, and the committee votes before anything is published.` },
    ],
    aside: `Two hats come off the Committee Chair when Training Coordinator is handed off: Youth Protection compliance sits with that role in Scouting America's duty list.`,
  },
  {
    id: 'budget',
    n: 4,
    title: 'Annual budget process',
    short: 'Budget process',
    due: 'Feb 28, 2027',
    badge: { kind: 'pend', label: 'Vote pending' },
    next: 'Written process and committee vote next',
    summary: `Establish a written annual budget process the committee owns and works from the troop's program calendar.`,
    smart: {
      s: `I will write the troop's annual budgeting process and bring it to the committee for adoption. The process sets when budgeting happens in the year, who supplies which numbers, how the program calendar drives the expense side, how income is estimated, and how the committee approves the result. Constraint: the treasurer's bookkeeping works and is not being replaced, and this goal is the process rather than any one year's numbers, so completing it does not wait on anyone else's schedule.`,
      m: `Done when a one to two page written budgeting process exists naming when budgeting happens each year and who owns each step, the committee has adopted it by recorded vote in the minutes, and it is published to the portal with a named maintainer and next year's budgeting dates on the committee calendar. Building an actual budget from it is the obvious next step and I intend to do it, but it is not the pass condition here.`,
      a: `Writing the process and putting it on a committee agenda are both entirely within my control as chair, which is the point of scoping the goal this way rather than around a budget that needs someone else's numbers on my timeline. Roadblocks: incomplete history to describe the estimating step, and a committee unused to voting on financial documents. This goal does not wait on goal 2: the process describes how a program calendar feeds a budget, and the troop has a calendar today. The two documents will co-evolve. Mitigation is writing the process from last year's actuals rather than from theory, and pairing the vote with the policy review already scheduled this fall.`,
      r: `A fiscally strong troop is a troop that is ready to support the annual plan. Anything less puts the youth experience at risk and places undue financial burden on families. In the model I asked this committee to adopt, our job is money, logistics and paperwork, and money is first on that list.`,
      t: `Process drafted by October 31, 2026. Reviewed with the treasurer and presented to the committee by November 30, 2026. Adopted by recorded committee vote and published to the member portal by February 28, 2027.`,
    },
    rows: [
      { item: 'Written process: when budgeting happens and who owns each step', evidence: `The troop's Financial Controls policy, posted on troop3054.org, already requires an annual budget developed by the Executive Committee. Still to add: when budgeting happens each year, who supplies which numbers, how the program calendar drives expenses, how income is estimated, and how the committee approves.`, kind: 'pend', status: 'In progress', href: 'https://www.troop3054.org/docs/Financial-Controls-Troop-3054-2025.pdf' },
      { item: 'Adopted by recorded committee vote, in the minutes', evidence: 'Motion on the Oct 14 agenda.', kind: 'sched', status: 'Oct 14' },
      { item: 'Published to the portal with a named maintainer', evidence: 'The Treasurer maintains it.', kind: 'sched', status: 'After vote' },
      { item: `Next year's budgeting dates on the committee calendar`, evidence: 'Added once the process is adopted.', kind: 'sched', status: 'After vote' },
    ],
    milestones: {
      heading: 'The process, run once (not a pass condition)',
      rows: [
        { item: 'First budget built with it', evidence: `Built in October from the Treasurer's statement: the program calendar sets the expense side and each line has an owner. Built before the process document, so the document describes what actually happened.`, kind: 'done', status: 'Oct 2026' },
        { item: 'Actuals reconciled with the Treasurer', evidence: 'Every unclear check explained by the Treasurer on Oct 5. One small deposit is still unidentified and is recorded that way.', kind: 'done', status: 'Oct 5' },
        { item: 'Budget vote', evidence: 'The 2026-27 budget itself, with the Treasurer present.', kind: 'sched', status: 'Nov 18' },
      ],
    },
    stats: {
      heading: 'What the first run showed',
      items: [
        { value: '$480', label: 'A year of troop costs: charter, ranks, merit badges, domain' },
        { value: '$100', label: 'A year of troop income, from donations' },
        { value: '~10 yrs', label: 'How long current reserves last with no new income' },
      ],
      after: `Popcorn commission goes to Scout accounts, not the troop, and families pay outing fees directly. Writing it down turned "we don't really have a budget" into a clear picture the committee can decide on: whether to set a small flat dues amount, and how much reserve to keep.`,
    },
    onRequest: 'The line-by-line 2026-27 budget, with the Treasurer\'s actuals beside each estimate, is available on request.',
    notes: [
      { who: 'Ticket counselor, Sept 2', said: 'Goal 4 put the Treasurer in the kill chain. No goal should have another person in it.', answer: `The goal was narrowed to the process only. The budget was still built, as the ticket intended, but completion never waited on anyone else's numbers.` },
    ],
    aside: `Bonus: Twin Rivers Council's Pathfinder program adds 3% to the popcorn commission for units that submit an annual budget, calendar, succession plan and membership plan. Goals 1 through 4 produce all four, and the commission goes to Scout accounts.`,
  },
  {
    id: 'foundations',
    n: 5,
    title: 'Foundations Weekend, coached and documented',
    short: 'Foundations Weekend',
    due: 'Dec 31, 2026',
    badge: { kind: 'sched', label: 'Nov 20-22' },
    next: 'The weekend, Nov 20-22, next',
    summary: 'Coach the PLC through the first Troop 3054 Foundations Weekend and document the planning process so future years can repeat it without me.',
    smart: {
      s: `I will coach the PLC through developing the first Troop 3054 Foundations Weekend, a Scout-led campout where older Scouts teach the Scout through First Class requirements the attending Scouts still need, picked from our advancement records, and I will document the planning process for future years. Each Scout instructor chooses which requirement to teach rather than being handed one, and we walk through Teaching EDGE at a PLC meeting beforehand. The weekend is the November 20-22, 2026 troop trip to Camp Wakpominee. Constraint: it is Scout-taught. Adults supervise, drive and cook.`,
      m: `This goal is complete when four things are done: the weekend is held, the PLC completes an after-action review, the planning procedure is posted to the Troop 3054 portal, and a placeholder for next year's Foundations Weekend is on the calendar.`,
      a: `Working with the senior patrol leader, the assistant senior patrol leader and the Scoutmaster, I have the skills to teach the troop leadership team to run this kind of event and to document the process. The concept has been talked about and the weekend is already on the calendar. Roadblock: I do not yet have individual commitments from the Scouts who would instruct. Mitigation is that Life requirement 6 is teaching another Scout with Teaching EDGE from the Tenderfoot through First Class list, so for our Star Scouts this weekend is their own advancement, and each instructor gets a coaching session with a merit badge counselor beforehand.`,
      r: `Reaching First Class in the first year is the strongest predictor of a Scout staying. This gives newer Scouts a concentrated path to it and gives older Scouts a real leadership assignment instead of a title, which serves both ends of the roster in the same weekend.`,
      t: `Concept presented to the PLC and the site reservation confirmed by September 30, 2026. Advancement gap list built by October 16, 2026. Program schedule and Scout instructor assignments complete by October 30, 2026. Weekend held November 20-22, 2026. After-action review done, planning procedure posted to the portal and next year's placeholder on the calendar by December 31, 2026.`,
    },
    rows: [
      { item: 'Weekend held', evidence: 'Troop trip to Camp Wakpominee, Nov 20-22. Scout-taught; adults supervise, drive and cook.', kind: 'sched', status: 'Nov 20-22' },
      { item: 'PLC after-action review', evidence: 'Added after the weekend.', kind: 'sched', status: 'By Dec 31' },
      { item: 'Planning procedure posted to the portal', evidence: `Written from how this year's weekend was planned, so the next PLC can repeat it.`, kind: 'sched', status: 'By Dec 31' },
      { item: `Next year's weekend on the calendar`, evidence: 'A placeholder for Foundations Weekend 2027.', kind: 'sched', status: 'By Dec 31' },
    ],
    milestones: {
      heading: 'Milestones (not pass conditions)',
      rows: [
        { item: 'Concept to the PLC; weekend on the calendar', evidence: 'Troop trip to Camp Wakpominee, Nov 20-22, on the live calendar.', kind: 'done', status: 'Done' },
        { item: 'Advancement gap list', evidence: 'The Scout through First Class requirements each attending Scout still needs, from advancement records.', kind: 'pend', status: 'Oct 16' },
        { item: 'Program schedule and Scout instructors', evidence: 'Each instructor picks the requirement they teach; Teaching EDGE walk-through at a PLC meeting.', kind: 'pend', status: 'Oct 30' },
      ],
    },
    notes: [
      { who: 'Course director, Sept 14', said: 'What do you need to do to ensure that the older Scouts are prepared? Are you comfortable you will get their support?', answer: 'Three things: Scouts pick their requirement from the gap list rather than being handed one, each instructor gets a coaching session with a merit badge counselor beforehand, and the PLC walks through Teaching EDGE first. For Star Scouts, teaching a Tenderfoot through First Class skill with Teaching EDGE is Life requirement 6, so the weekend is their own advancement too.' },
    ],
    aside: 'This section fills in after the weekend: the schedule, instructor list, after-action review and photos, with no Scout faces shown.',
  },
];

const progress = (g: Goal) => {
  const done = g.rows.filter((r) => r.kind === 'done').length;
  const pend = g.rows.filter((r) => r.kind === 'pend').length;
  const miles = g.milestones?.rows ?? [];
  return {
    done,
    pend,
    total: g.rows.length,
    pct: Math.round((done / g.rows.length) * 100),
    pendPct: Math.round((pend / g.rows.length) * 100),
    milesDone: miles.filter((r) => r.kind === 'done').length,
    milesTotal: miles.length,
  };
};

const smartParts = [
  ['s', 'Specific'],
  ['m', 'Measurable'],
  ['a', 'Attainable'],
  ['r', 'Relevant'],
  ['t', 'Timely'],
] as const;

// Pack numbers by rank, council roster Oct 4 plus families in progress.
const scoutPath = [
