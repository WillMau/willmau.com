];

const comingUp: Row[] = [
  { item: 'Oct 14 committee meeting', evidence: 'Votes on the budget process, the roles matrix with its review rotation, and the recruiting process (troop side). Minutes record that program planning belongs to the PLC.', kind: 'sched', status: 'Scheduled' },
  { item: 'October', evidence: 'Pack Key 3 written approval of the joint recruiting process and the pack website.', kind: 'pend', status: 'Requested' },
  { item: 'Nov 18 committee meeting', evidence: 'Vote on the 2026-27 budget with the Treasurer present.', kind: 'sched', status: 'Scheduled' },
  { item: 'Nov 20-22', evidence: 'Foundations Weekend at Camp Wakpominee.', kind: 'sched', status: 'Scheduled' },
];

const systemsShots: Shot[] = [
  { img: troopHome, alt: 'troop3054.org home page', title: 'troop3054.org.', text: `The troop's front door.` },
  { img: troopGovernance, alt: 'troop3054.org Committee and Governance page', title: 'Governance page.', text: 'Open meetings, published agendas and minutes.' },
  { img: packCalendar, alt: 'pack3054.org calendar', title: 'Pack calendar.', text: 'Subscribe on a phone, filter by den, or show troop events alongside.' },
  { img: packMobile, alt: 'pack3054.org on a phone', title: 'On a phone.', text: 'Both sites are built for the phone first.', tall: true },
];

const timeline = [
  ['Aug 28-30', 'Wood Badge Weekend 1, Camp Wakpominee.'],
  ['Aug 31', 'First ticket draft to my ticket counselor: five goals, all pointed at a troop that keeps running without depending on any one adult.'],
  ['Sept 2 · First review', `"The ticket is the acorn, not the whole tree." No goal should have another person in its kill chain. Use national tools. Name where each document lives, who maintains it and when it is reviewed. Don't over-delegate to youth. Goal 4 narrowed to the process only.`],
  ['Sept 9 · Second review', '"The scoping of this ticket is on point. Ambitious, but not killing yourself." Every measurable became one sentence a cold reader can check; Goal 2 restored its procedure document; Goal 5 was rewritten around coaching the PLC.'],
  [`Sept 14 · Course director's questions`, 'A feedback cycle with the PLC (Goal 2), alignment of position descriptions (Goal 3), and preparing the older Scouts (Goal 5). Answered the same day: "Great insights. Please refine the goals with these and think we are looking good for your ticket."'],
  ['Sept 19-20', 'Wood Badge Weekend 2. Final ticket sent.'],
  ['Oct 2026', 'Work underway on all five goals.'],
];

const draftingRules = [
  'Roles, not names, in the goal text.',
  `No goal depends on another person producing work on my timeline, on a second annual cycle, or on another goal's output.`,
  'Recruitment headcount is an outcome, never the pass condition.',
  'Every Attainable names a real roadblock and its mitigation.',
];

const nextCycle = [
  ['Joint New Scout Night and open house tables', 'Pack and troop New Member Coordinators', 'September'],
  ['Foundations Weekend', 'Senior Patrol Leader and the PLC', 'November'],
  ['Arrow of Light crossover at Blue & Gold', 'Cubmaster, with troop Scouts running the bridge', 'March'],
  ['New Scouts camp with the troop within 30 days of crossing', 'Scoutmaster and Troop Guide', 'April'],
  ['Annual planning conference', 'Senior Patrol Leader', 'Spring'],
  [`Budget built from the PLC's new calendar`, 'Treasurer', 'After the conference'],
  [`Recruiting review: last year's numbers, BeAScout pins`, `Each unit's Key 3 and the troop committee`, 'May'],
  ['Committee document review rotation', 'Committee, one or two documents a year', 'Set at adoption'],
];

const meta = [
  ['Course', 'Twin Rivers Council Wood Badge 2026'],
  ['Ticket approved', 'Sept 14, 2026'],
  ['Completion deadline', 'Mar 20, 2028'],
  ['Status as of', asOf],
];
---

<Base
  title="Wood Badge Ticket | Will Mau"
  description="Will Mau's Wood Badge ticket as Committee Chair of Scouting America Troop 3054: five goals that leave the troop running without depending on any one adult, with the evidence for each."
>
  <main id="main">
    <section class="page-hero">
      <SiteHeader />
      <div class="wrap page-hero__inner wb-hero">
        <div>
          <p class="kicker page-hero__kicker" data-reveal>Wood Badge ticket</p>
          <h1 class="page-hero__title" data-reveal data-reveal-delay="1">
            What keeps<br />running after<br />I stop.
          </h1>
          <p class="page-hero__note" data-reveal data-reveal-delay="2">
            I chair the committee of Troop 3054, Mohawk District, Twin Rivers
            Council. My Wood Badge ticket is five goals, each a written process
            the committee owns, so the troop runs well without depending on any
            one adult, including me. This page is the evidence, updated as the
            work moves.
          </p>
          <dl class="wb-meta" data-reveal data-reveal-delay="3">
            {meta.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="wb-beads" aria-hidden="true">
          <span class="wb-beads__thong"></span>
          <span class="wb-beads__bead"></span>
          <span class="wb-beads__bead"></span>
          <span class="wb-beads__thong"></span>
        </div>
      </div>
    </section>

    <div class="wb">
      <div class="wrap wb__layout">
        <nav class="wb-toc" aria-label="On this page">
          <p class="wb-toc__label">On this page</p>
          <ol>
            <li><a href="#vision">Vision</a></li>
            <li><a href="#status">Where things stand</a></li>
            {goals.map((g) => (
              <li><a href={`#${g.id}`}><span class="wb-toc__n">{g.n}</span>{g.short}</a></li>
            ))}
            <li><a href="#systems">Systems built</a></li>
            <li><a href="#shaped">How the ticket was shaped</a></li>
            <li><a href="#next-year">Who runs it next year</a></li>
            <li><a href="#on-request">Available on request</a></li>
          </ol>
        </nav>

        <div class="wb__main">
          {/* Vision */}
          <section id="vision" class="wb-sec">
            <p class="wb-label">My personal vision of success</p>
            <div class="wb-prose wb-vision">
              <p>
                Troop 3054 should be able to run well without depending on any
                one adult, including me. My vision is a troop where the Scouts
                plan and lead the program, where the committee's job is money,
                logistics, permits, drivers and paperwork rather than deciding
                what the Scouts will do, and where every key responsibility has
                more than one person who knows how to carry it.
              </p>
              <p>
                That means leaving behind systems, not projects: a recruitment
                cycle the pack and the troop run together every year, a Patrol
                Leaders' Council that plans the program the way Scouting America
                intends, a written record of who holds what and who backs them
                up, a budget process the committee owns, and one weekend a year
                where the older Scouts teach the younger ones what this is
                supposed to feel like. Each of those lives somewhere findable,
                with a name on it and a date it gets reviewed.
              </p>
            </div>
            <p class="wb-pull">
              The measure of success is not what I run while I am here. It is
              what keeps running after I stop.
            </p>
          </section>

          {/* Status */}
          <section id="status" class="wb-sec">
            <div class="wb-head">
              <p class="wb-label">Status as of {asOf}</p>
              <h2 class="wb-h2">Where each goal stands</h2>
            </div>
            <p class="wb-lede">
              Every goal closes the same way: a written process, adopted by
              recorded committee vote where required, posted to the troop portal
              with a named maintainer, plus evidence that it ran once.
            </p>
            <div class="wb-cards">
              {goals.map((g) => {
                const p = progress(g);
                return (
                  <a class="wb-card" href={`#${g.id}`}>
                    <span class="wb-card__top">
                      <span class="wb-card__n">Goal {g.n}</span>
                      <span class={`wb-chip wb-chip--${g.badge.kind}`}>{g.badge.label}</span>
                    </span>
                    <span class="wb-card__title">{g.title}</span>
                    <span class="wb-card__due">Due {g.due}</span>
                    <span class="wb-bar" role="img" aria-label={`${p.done} of ${p.total} done`}>
                      <span style={`width:${p.pct}%`}></span>
                    </span>
                    <span class="wb-card__count">
                      <strong>{p.done} of {p.total} done.</strong> {g.next}.
                    </span>
                  </a>
                );
              })}
            </div>

            <h3 class="wb-h3">Coming up</h3>
            <div class="wb-table">
              <table>
                <thead>
                  <tr><th scope="col">When</th><th scope="col">What happens</th><th scope="col">Status</th></tr>
                </thead>
                <tbody>
                  {comingUp.map((r) => (
                    <tr>
                      <td>{r.item}</td>
                      <td>{r.evidence}</td>
                      <td><span class={`wb-chip wb-chip--${r.kind}`}>{r.status}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          {/* Goals */}
          {goals.map((g) => (
            <section id={g.id} class="wb-sec">
              <div class="wb-head">
                <p class="wb-label">Goal {g.n} &middot; due {g.due}</p>
                <h2 class="wb-h2">{g.title}</h2>
                <span class={`wb-chip wb-chip--${g.badge.kind}`}>{g.badge.label}</span>
              </div>
              <p class="wb-lede">{g.summary}</p>

              <div class="wb-measure">
                <p class="wb-measure__label">Done when</p>
                <p class="wb-measure__text">{g.smart.m}</p>
              </div>

              <h3 class="wb-h3">Evidence against the measurable</h3>
              <div class="wb-table">
                <table>
                  <thead>
                    <tr><th scope="col">Pass condition</th><th scope="col">Evidence</th><th scope="col">Status</th></tr>
                  </thead>
                  <tbody>
                    {g.rows.map((r) => (
                      <tr>
                        <td>{r.item}</td>
                        <td>{r.evidence}</td>
                        <td><span class={`wb-chip wb-chip--${r.kind}`}>{r.status}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {g.stats && (
                <>
                  <h3 class="wb-h3">{g.stats.heading}</h3>
                  <div class="wb-stats">
                    {g.stats.items.map((s) => (
                      <div class="wb-stat">
                        <strong>{s.value}</strong>
                        <span>{s.label}</span>
                      </div>
                    ))}
                  </div>
                  {g.id === 'recruiting' && (
                    <>
                      <p class="wb-small">The path a Scout takes, with this fall's pack numbers (council roster Oct 4, plus families in progress):</p>
                      <ol class="wb-path">
                        {scoutPath.map(([rank, count]) => (
                          <li><strong>{rank}</strong>{count}</li>
                        ))}
                        <li class="wb-path__end"><strong>Troop</strong>Crossover</li>
                      </ol>
                    </>
                  )}
                  {g.stats.after && <p class="wb-body">{g.stats.after}</p>}
                </>
              )}

              {g.points && (
                <>
                  <h3 class="wb-h3">{g.points.heading}</h3>
                  <ul class="wb-list">
                    {g.points.items.map((pt) => (
                      <li>{pt.lead && <strong>{pt.lead} </strong>}{pt.text}</li>
                    ))}
                  </ul>
                </>
              )}

              {g.shots && (
                <>
                  <h3 class="wb-h3">Artifacts</h3>
                  <div class="wb-gallery">
                    {g.shots.map((s) => (
                      <figure>
                        <a class:list={['wb-shot', { 'wb-shot--tall': s.tall, 'wb-shot--whole': s.whole }]} href={s.img.src} target="_blank" rel="noopener">
                          <Image src={s.img} alt={s.alt} widths={[360, 720]} sizes="(max-width: 640px) 100vw, 260px" loading="lazy" />
                        </a>
                        <figcaption><strong>{s.title}</strong> {s.text}</figcaption>
                      </figure>
                    ))}
                  </div>
                </>
              )}

              {g.onRequest && <p class="wb-request-note">{g.onRequest} <a href="#on-request">How to ask</a></p>}

              <h3 class="wb-h3">Feedback this goal answers</h3>
              {g.notes.map((n) => (
                <div class="wb-note">
                  <blockquote class="wb-q">
                    <p class="wb-q__who">{n.who}</p>
                    <p>{n.said}</p>
                  </blockquote>
                  <p class="wb-body">{n.answer}</p>
                </div>
              ))}
              {g.aside && <p class="wb-small">{g.aside}</p>}

              <details class="wb-smart">
                <summary>The full SMART goal, as approved</summary>
                <dl>
                  {smartParts.map(([k, label]) => (
                    <div class="wb-smart__row">
                      <dt><span class="wb-smart__letter">{k.toUpperCase()}</span>{label}</dt>
                      <dd>{g.smart[k]}</dd>
                    </div>
                  ))}
                </dl>
                <p class="wb-small">Promotes membership growth and retention: Yes. Shows a line of sight to the youth: Yes.</p>
              </details>
            </section>
          ))}

          {/* Systems */}
          <section id="systems" class="wb-sec">
            <div class="wb-head">
              <p class="wb-label">Where the work lives</p>
              <h2 class="wb-h2">Systems built to hold the work</h2>
            </div>
            <p class="wb-lede">
              Each goal's process lives somewhere findable, with a name on it and
              a review date. Three systems hold them. All work on iPhone, Android
              and PC, and day-to-day content is self-serve for leaders, so none
              of it depends on one person to keep current.
            </p>
            <div class="wb-two">
              <div>
                <h3 class="wb-h3">Member portal &middot; my.troop3054.org</h3>
                <ul class="wb-list">
                  <li>Program planning: Plan cards, reviews and the Program page (Goal 2)</li>
                  <li>Recruiting page with the joint process and post toolkit (Goal 1)</li>
                  <li>Roles &amp; backups, feeding the public site (Goal 3)</li>
                  <li>A calendar that feeds the public site and families' phone calendars</li>
                  <li>Sign-in by emailed code, no passwords; access follows a person's position</li>
                  <li>Youth protection by design: no private messages, and notifications pause overnight</li>
                </ul>
              </div>
              <div>
                <h3 class="wb-h3">Public sites &middot; troop3054.org and pack3054.org</h3>
                <ul class="wb-list">
                  <li>The two sites point to each other: "Ages 11 to 17? Visit Troop 3054" and "Visit Pack 3054"</li>
                  <li>Every Join path ends at Scouting America's own application</li>
                  <li>The pack's leader app updates the pack website and families' calendars with no publishing step</li>
                  <li>A Committee &amp; Governance page publishes meeting dates, agendas and minutes</li>
                  <li>Drawings instead of photos of children on the pack site</li>
                </ul>
              </div>
            </div>

            <h3 class="wb-h3">Continuity</h3>
            <ul class="wb-list">
              <li><strong>Written handoff guides.</strong> The pack site ships with a maintainer's guide for a non-programmer: how pages, the calendar and publishing work.</li>
              <li><strong>Access recorded, not passwords.</strong> The roles matrix lists who holds the domain, hosting, bank and records, and how each transfers.</li>
              <li><strong>Still to do:</strong> a second portal admin, and a one-page note of where each account lives and who holds it, for both units.</li>
            </ul>

            <h3 class="wb-h3">Screens</h3>
            <div class="wb-gallery">
              {systemsShots.map((s) => (
                <figure>
                  <a class:list={['wb-shot', { 'wb-shot--tall': s.tall, 'wb-shot--whole': s.whole }]} href={s.img.src} target="_blank" rel="noopener">
                    <Image src={s.img} alt={s.alt} widths={[360, 720]} sizes="(max-width: 640px) 100vw, 260px" loading="lazy" />
                  </a>
                  <figcaption><strong>{s.title}</strong> {s.text}</figcaption>
                </figure>
              ))}
            </div>
            <p class="wb-small">
              The portal holds youth information, so it appears here in dated
              screenshots rather than through reviewer accounts. A live
              walkthrough is <a href="#on-request">available on request</a>.
            </p>
          </section>

          {/* How the ticket was shaped */}
          <section id="shaped" class="wb-sec">
            <div class="wb-head">
              <p class="wb-label">Reviews</p>
              <h2 class="wb-h2">How the ticket was shaped</h2>
            </div>
            <ol class="wb-timeline">
              {timeline.map(([when, what]) => (
                <li>
                  <p class="wb-timeline__when">{when}</p>
                  <p class="wb-body">{what}</p>
                </li>
              ))}
            </ol>
            <h3 class="wb-h3">Drafting rules the ticket kept</h3>
            <ul class="wb-list">
              {draftingRules.map((r) => <li>{r}</li>)}
            </ul>
          </section>

          {/* Next cycle */}
          <section id="next-year" class="wb-sec">
            <div class="wb-head">
              <p class="wb-label">The next cycle</p>
              <h2 class="wb-h2">Who runs it next year</h2>
            </div>
            <p class="wb-lede">
              The proof of the vision is that each process repeats on its own
              schedule, with someone other than the Committee Chair named on it.
            </p>
            <div class="wb-table">
              <table>
                <thead>
                  <tr><th scope="col">Recurring step</th><th scope="col">Owner</th><th scope="col">When</th></tr>
                </thead>
                <tbody>
                  {nextCycle.map(([step, owner, when]) => (
                    <tr>
                      <td>{step}</td>
                      <td>{owner}</td>
                      <td>{when}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          {/* On request */}
          <section id="on-request" class="wb-sec">
            <div class="wb-request">
              <p class="wb-label">For reviewers</p>
              <h2 class="wb-h2">Available on request</h2>
              <p class="wb-body">
                Some of the evidence names individual volunteers or families, or
                shows the troop's accounts, so it is not on this page. Any of it
                is available to my ticket counselor and course director:
              </p>
              <ul class="wb-list">
                <li>The line-by-line 2026-27 troop budget, with the Treasurer's actuals</li>
                <li>The adult positions summary and the portal's roles matrix, with names</li>
                <li>A live walkthrough of the member portal</li>
              </ul>
              <p class="wb-body">
                Ask at <a href="mailto:will@willmau.com">will@willmau.com</a>.
              </p>
              <p class="wb-small">Scout names and faces are not shown. Screenshots were taken {asOf}.</p>
            </div>
          </section>
        </div>
      </div>
    </div>

    <SiteFooter />
  </main>
</Base>

<style>
  .wb {
    --wb-done: #2f6b4b;
    --wb-done-bg: #e2efe6;
    --wb-pend: #7a5200;
    --wb-pend-bg: #f8ecd0;
    --wb-sched: var(--ink);
    --wb-sched-bg: #e4e7f3;
    --wb-tan: #b0956a;
    background: var(--paper);
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* Hero additions */
  .wb-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: end;
  }
  .wb-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 2rem;
    margin-top: 1.6rem;
  }
  .wb-meta dt {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-soft);
  }
  .wb-meta dd {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
  }
  .wb-beads {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.4rem;
  }
  .wb-beads__thong {
    width: 2.6rem;
    height: 3px;
    border-radius: 2px;
    background: #c9a777;
  }
  .wb-beads__bead {
    width: 1.05rem;
    height: 1.8rem;
    border-radius: 0.55rem;
    background: linear-gradient(180deg, #b88a56, #7a5530);
    box-shadow: inset 0 -3px 0 rgba(0, 0, 0, 0.22);
  }

  /* Layout */
  .wb__layout {
    display: grid;
    grid-template-columns: 12.5rem minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }
  .wb__main { min-width: 0; }

  .wb-toc {
    position: sticky;
    top: 2rem;
    align-self: start;
    font-size: 0.88rem;
  }
  .wb-toc__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-bottom: 0.7rem;
  }
  .wb-toc ol {
    list-style: none;
    border-left: 2px solid var(--line);
  }
  .wb-toc a {
    display: flex;
    gap: 0.45rem;
    padding: 0.32rem 0 0.32rem 0.9rem;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--text-soft);
    line-height: 1.35;
    transition: color 0.16s var(--ease), border-color 0.16s var(--ease);
  }
  .wb-toc a:hover {
    color: var(--ink);
    border-left-color: var(--green);
  }
  .wb-toc__n {
    font-weight: 700;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* Sections and type */
  .wb-sec {
    padding-block: 2.6rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }
  .wb-sec:first-child { border-top: 0; padding-top: 0; }

  .wb-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 0.9rem;
  }
  .wb-head .wb-label { flex-basis: 100%; margin-bottom: 0; }
  .wb-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--green);
    margin-bottom: 0.6rem;
  }
  .wb-h2 {
    font-size: clamp(1.55rem, 1.25rem + 1vw, 2.1rem);
    color: var(--ink);
  }
  .wb-h3 {
    font-size: 1.2rem;
    color: var(--ink);
    margin: 2.1rem 0 0.8rem;
  }
  .wb-lede {
    font-size: 1.08rem;
    color: var(--text-soft);
    max-width: 66ch;
  }
  .wb-body {
    font-size: 1rem;
    max-width: 68ch;
    margin-top: 0.8rem;
  }
  .wb-body a,
  .wb-small a,
  .wb-request-note a {
    color: var(--ink);
    border-bottom: 1px solid var(--green);
  }
  .wb-small {
    font-size: 0.88rem;
    color: var(--text-soft);
    max-width: 68ch;
    margin-top: 0.9rem;
  }

  .wb-prose p {
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.65;
    color: var(--ink);
    max-width: 64ch;
  }
  .wb-prose p + p { margin-top: 1.1rem; }
  .wb-pull {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.7rem);
    line-height: 1.3;
    color: var(--ink);
    max-width: 30ch;
    margin-top: 1.8rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--green);
  }

  /* Status chips */
  .wb-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .wb-chip::before {
