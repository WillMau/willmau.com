      { item: 'Tested by a crossover-season event', evidence: `Arrow of Light crossover at Blue & Gold, with troop Scouts running the bridge.`, kind: 'sched', status: 'Mar 15, 2027' },
    ],
    stats: {
      heading: 'What ran this fall',
      items: [
        { value: '31', label: 'Cubs registered in the pack (Oct 4)' },
        { value: '16', label: 'Families who started an application or asked' },
        { value: '8', label: 'Arrow of Light Scouts, the next crossover class' },
        { value: '8 → 5', label: 'New troop Scouts this year, still active in October' },
