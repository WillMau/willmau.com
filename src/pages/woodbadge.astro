  ['Committee document review rotation', 'Committee, one or two documents a year', 'Set at adoption'],
];

const meta = [
  ['Course', 'Twin Rivers Council Wood Badge 2026'],
  ['Course number', '10-364-26'],
  ['Patrol', 'Buffalo'],
  ['Ticket approved', 'Sept 19, 2026'],
  ['Completion deadline', 'Mar 20, 2028'],
  ['Status as of', asOf],
];

// The road to the beads, shown in the hero. The ticket step counts itself from the goal rows.
const ticketDone = goals.reduce((n, g) => n + progress(g).done, 0);
const ticketPend = goals.reduce((n, g) => n + progress(g).pend, 0);
const ticketTotal = goals.reduce((n, g) => n + progress(g).total, 0);
const trail = [
  { label: 'Course weekends', when: 'Aug and Sept 2026', state: 'done' },
  { label: 'Ticket approved', when: 'Sept 19, 2026', state: 'done' },
  { label: 'Working the ticket', when: `${ticketDone} of ${ticketTotal} pass conditions met, ${ticketPend} in progress`, state: 'now' },
