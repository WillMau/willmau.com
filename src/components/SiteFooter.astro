---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <img class="site-footer__mark" src="/favicon.png" alt="" width="56" height="56" />
      <a href="mailto:will@willmau.com" class="site-footer__big" data-reveal>
        will@willmau.com
        <span class="site-footer__arrow" aria-hidden="true">&#8599;</span>
      </a>
    </div>

    <div class="site-footer__grid">
      <nav class="site-footer__col" aria-label="Elsewhere">
        <p class="site-footer__label">Elsewhere</p>
        <a href="https://www.linkedin.com/in/will-mau/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://mauops.com" target="_blank" rel="noopener noreferrer">Mauops</a>
      </nav>
      <nav class="site-footer__col" aria-label="This site">
        <p class="site-footer__label">This site</p>
        <a href="/about">About</a>
        <a href="/resume">Résumé</a>
        <a href="/civic">Civic work</a>
      </nav>
    </div>

    <div class="site-footer__signup">
      <p class="site-footer__label">Get civic updates</p>
      <p class="site-footer__signup-note">
        About five emails a year. School board work, budget votes, district news.
        <a href="/civic">More on the civic page &rarr;</a>
      </p>
      <form
        id="footer-signup"
        class="footer-form"
        action="https://assets.mailerlite.com/jsonp/2374393/forms/188288639710529388/subscribe"
        method="POST"
        novalidate
      >
        <label class="sr-only" for="footer-name">First name (optional)</label>
        <input
          id="footer-name"
          class="footer-form__input"
          type="text"
          name="fields[name]"
          placeholder="First name (optional)"
          autocomplete="given-name"
        />
        <label class="sr-only" for="footer-email">Email address</label>
        <input
          id="footer-email"
          class="footer-form__input"
          type="email"
          name="fields[email]"
          placeholder="you@email.com"
          autocomplete="email"
          required
        />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <input type="hidden" name="fields[signup_source]" value="footer" />
        <div class="footer-form__pot" aria-hidden="true">
          <label for="footer-website">Leave this field empty</label>
          <input type="text" id="footer-website" name="website_url" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="footer-form__btn">Subscribe</button>
      </form>
      <p id="footer-status" class="footer-form__status" role="status" aria-live="polite"></p>
    </div>

    <div class="site-footer__base">
      <span>&copy; {year} Will Mau &middot; Rotterdam, New York</span>
      <a href="/privacy" class="site-footer__base-link">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-deep);
    color: var(--on-dark);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .site-footer__top {
    border-bottom: 1px solid var(--line-dark);
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .site-footer__mark {
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.4rem;
  }
  .site-footer__big {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.5rem, 1.1rem + 1.7vw, 2.4rem);
    letter-spacing: -0.02em;
    color: var(--on-dark);
    display: inline-flex;
    align-items: flex-start;
    gap: 0.2em;
    transition: color 0.2s var(--ease);
  }
  .site-footer__arrow {
    font-size: 0.6em;
    color: var(--green-bright);
    transition: transform 0.22s var(--ease);
  }
  .site-footer__big:hover { color: var(--green-bright); }
  .site-footer__big:hover .site-footer__arrow {
    transform: translate(0.15em, -0.15em);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 32rem;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .site-footer__label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--green-bright);
    margin-bottom: 0.3rem;
  }
  .site-footer__col a {
    color: var(--on-dark-soft);
    transition: color 0.16s var(--ease);
    width: fit-content;
  }
  .site-footer__col a:hover { color: var(--on-dark); }

  .site-footer__signup {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(2rem, 4vw, 2.5rem);
    border-top: 1px solid var(--line-dark);
    max-width: 32rem;
  }
  .site-footer__signup-note {
    font-size: 0.85rem;
    color: var(--on-dark-soft);
    margin: 0 0 0.9rem;
    line-height: 1.5;
  }
  .site-footer__signup-note a {
    color: var(--green-bright);
    border-bottom: 1px solid transparent;
    transition: border-color 0.18s var(--ease);
  }
  .site-footer__signup-note a:hover { border-bottom-color: var(--green-bright); }

  .footer-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .footer-form[hidden] { display: none; }
  .footer-form__input {
    width: 100%;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid transparent;
    border-radius: 8px;
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .footer-form__input:focus {
    outline: none;
    border-color: var(--green-bright);
    box-shadow: 0 0 0 3px rgba(111, 207, 151, 0.25);
  }
  .footer-form__btn {
    align-self: flex-start;
    padding: 0.7rem 1.2rem;
    font: inherit;
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--ink);
    background: var(--green-bright);
    border: 1px solid var(--green-bright);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.18s var(--ease), transform 0.12s var(--ease);
  }
  .footer-form__btn:hover:not(:disabled) {
    background: #8ed9af;
    transform: translateY(-1px);
  }
  .footer-form__btn:disabled { opacity: 0.7; cursor: progress; }
  .footer-form__pot {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .footer-form__status {
    font-size: 0.85rem;
    margin: 0.6rem 0 0;
    color: var(--on-dark-soft);
    min-height: 1.3em;
  }
  .footer-form__status.is-success { color: var(--green-bright); }
  .footer-form__status.is-error { color: #ff8d8d; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .site-footer__base {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--on-dark-soft);
  }
  .site-footer__base-link {
    color: var(--on-dark-soft);
    transition: color 0.16s var(--ease);
  }
  .site-footer__base-link:hover { color: var(--on-dark); }
  @media (max-width: 640px) {
    .site-footer__grid { grid-template-columns: 1fr; gap: 2.25rem; }
  }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById('footer-signup');
    const status = document.getElementById('footer-status');
    if (!form || !status) return;
    const renderedAt = Date.now();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot
      const pot = form.querySelector('input[name="website_url"]');
      if (pot && pot.value) {
        status.textContent = "Thanks. You're on the list.";
        status.classList.remove('is-error');
        status.classList.add('is-success');
        form.reset();
        form.hidden = true;
        return;
      }

      // Time-trap
      if (Date.now() - renderedAt < 2000) {
        status.textContent = "Thanks. You're on the list.";
        status.classList.remove('is-error');
        status.classList.add('is-success');
        form.reset();
        form.hidden = true;
        return;
      }

      const emailInput = form.querySelector('input[type="email"]');
      const email = (emailInput && emailInput.value || '').trim();
      const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      if (!valid) {
        status.textContent = 'Please enter a valid email address.';
        status.classList.remove('is-success');
        status.classList.add('is-error');
        return;
      }

      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Subscribing…';

      try {
        const formData = new FormData(form);
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          body: formData,
        });
        status.textContent = "Thanks. You're on the list.";
        status.classList.remove('is-error');
        status.classList.add('is-success');
        form.reset();
        form.hidden = true;
      } catch (err) {
        status.textContent = 'Something went wrong. Please try again.';
        status.classList.remove('is-success');
        status.classList.add('is-error');
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    });
  })();
</script>
