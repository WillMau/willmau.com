---
const links = [
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Résumé' },
  { href: 'mailto:will@willmau.com', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__row">
    <a href="/" class="wordmark" aria-label="Will Mau, home">
      Will Mau<span class="wordmark__dot" aria-hidden="true"></span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['site-nav__link', { 'is-current': path === l.href }]}
            aria-current={path === l.href ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.32rem;
    letter-spacing: -0.018em;
    color: var(--on-dark);
    display: inline-flex;
    align-items: baseline;
    gap: 0.2rem;
  }
  .wordmark__dot {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--green);
    display: inline-block;
  }
  .site-nav {
    display: flex;
    gap: clamp(1rem, 3.5vw, 2.5rem);
  }
  .site-nav__link {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-soft);
    padding-block: 0.35rem;
    position: relative;
    transition: color 0.18s var(--ease);
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s var(--ease);
  }
  .site-nav__link:hover,
  .site-nav__link.is-current {
    color: var(--on-dark);
  }
  .site-nav__link:hover::after,
  .site-nav__link.is-current::after {
    transform: scaleX(1);
  }
</style>
